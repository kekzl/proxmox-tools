# ---------------------------------------------------------------- storage and source

def storage_root(s):
    return s.get("path") or f"/mnt/pve/{s.get('storage')}"


def file_storages(backend, node):
    """File storages usable on this node, by id."""
    out = {}
    for s in backend.get("/storage") or []:
        nodes = s.get("nodes")
        if s.get("type") in FILE_STORAGE_TYPES and not _int(s.get("disable")) and (
                not nodes or node in nodes.split(",")):
            out[s["storage"]] = s
    return out


def snapshot_dirs(root, vmid):
    """(snapshot name, snapshot root, image dir) of every filer snapshot holding images of vmid."""
    out = []
    for sd in SNAPDIRS:
        base = os.path.join(root, sd)
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        for n in names:
            d = os.path.join(base, n, "images", str(vmid))
            if os.path.isdir(d):
                out.append((n, os.path.join(base, n), d))
    return out


def image_format(name):
    """By extension, never probed: a guest can write a qcow2 header into its raw disk."""
    ext = name.rsplit(".", 1)[-1] if "." in name else ""
    return ext if ext in ("qcow2", "vmdk") else "raw"


def image_info(args, path, fmt):
    cmd = [args.qemu_img, "info", "-U", "--backing-chain", "--output=json", "-f", fmt, path]
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True,
                           timeout=INFO_TIMEOUT)
        if p.returncode != 0:
            raise PveError(f"qemu-img info {path}: {p.stderr.strip()}")
        chain = json.loads(p.stdout)
        if not isinstance(chain, list) or not chain or "virtual-size" not in chain[0]:
            raise PveError(f"qemu-img info {path}: unexpected output")
        return chain
    except subprocess.TimeoutExpired as e:
        raise PveError(f"qemu-img info {path}: no answer after {INFO_TIMEOUT}s") from e
    except (OSError, ValueError) as e:
        raise PveError(f"qemu-img info {path}: {e}") from e


def inside(path, root):
    real, root = os.path.realpath(str(path)), os.path.realpath(root)
    return real == root or real.startswith(root + os.sep)


def source_dirs(args, storages, vmid):
    """{storage id or '': (root, image dir)}; '' = one directory given with --from for all disks."""
    if "/" in args.source:
        d = os.path.abspath(args.source)
        if not os.path.isdir(d):
            raise PveError(f"--from {args.source}: not a directory")
        parent = os.path.dirname(d)
        return {"": (os.path.dirname(parent) if os.path.basename(parent) == "images" else d, d)}
    out = {}
    for sid, s in sorted(storages.items()):
        for name, root, d in snapshot_dirs(storage_root(s), vmid):
            if name == args.source:
                out[sid] = (root, d)
                break
    if not out:
        raise PveError(f"filer snapshot '{args.source}' holds no images of {vmid} on any file storage of this node: "
                       f"see 'pverestore sources {vmid}'")
    return out


def chain_snapshots(d, name):
    try:
        found = (CHAIN_FILE_RE.match(f) for f in os.listdir(d))
    except OSError:
        return []
    return sorted(m.group(1) for m in found if m and m.group(2) == name)


def resolve_disk(args, disk, root, d):
    """Fills source path, format, size and the state to copy; sets disk.error instead of raising."""
    names = [disk.name] if "." in disk.name else [disk.name, disk.name + ".raw", disk.name + ".qcow2"]
    name = next((n for n in names if os.path.isfile(os.path.join(d, n))), None)
    if name is None:
        disk.error, disk.missing = f"{os.path.join(d, disk.name)} not found", True
        return
    disk.name, disk.fmt = name, image_format(name)
    path = os.path.join(d, name)
    chain_names = chain_snapshots(d, name)
    if args.snapshot in chain_names:
        path, disk.state = os.path.join(d, f"snap-{args.snapshot}-{name}"), f"chain file of '{args.snapshot}'"
    try:
        chain = image_info(args, path, disk.fmt)
    except PveError as e:
        disk.error = str(e)
        return
    outside = [c.get("filename") for c in chain if not inside(c.get("filename"), root)]
    if outside:
        disk.error = f"backing file {outside[0]} is outside the source {root}: result would mix two points in time"
        return
    internal = [s["name"] for s in chain[0].get("snapshots") or [] if s.get("name")]
    disk.snaps = sorted(set(internal) | set(chain_names))
    if args.snapshot and not disk.state:
        if args.snapshot not in internal:
            disk.error = f"{path}: no snapshot '{args.snapshot}' (has: {', '.join(disk.snaps) or 'none'})"
            return
        disk.snapshot, disk.state = args.snapshot, f"internal snapshot '{args.snapshot}'"
    elif not disk.state:
        disk.state = "active state" + (f", chain of {len(chain)} files" if len(chain) > 1 else "")
    disk.src, disk.size = path, int(chain[0]["virtual-size"])


# ---------------------------------------------------------------- config

def parse_drive(value):
    vol, _, rest = str(value).partition(",")
    return vol, [o for o in rest.split(",") if o and not o.startswith("size=")]


def split_config(cfg, cloudinit_storage=None):
    """Guest config -> (create params, late drive params, disks, notes). Late = set after the import."""
    create, late, disks, notes = {}, {}, [], []
    for key in sorted(cfg):
        value = cfg[key]
        if key in DROP_KEYS or key in ("boot", "bootdisk"):
            if key == "cipassword":
                notes.append("cipassword not copied (the API returns it masked): set it again")
            continue
        if DROP_RE.match(key) or (re.match(r"^usb\d+$", key) and "host=" in str(value)):
            if not key.startswith("unused"):
                notes.append(f"{key} not copied: host device stays with the original VM")
            continue
        if NET_RE.match(key):
            parts = [p for p in str(value).split(",") if not p.startswith("link_down=")]
            create[key] = ",".join(parts + ["link_down=1"])
            continue
        if not DRIVE_RE.match(key):
            create[key] = value
            continue
        vol, opts = parse_drive(value)
        if "media=cdrom" in opts or vol in ("none", "cdrom"):
            if "cloudinit" in vol:
                sid = cloudinit_storage or vol.split(":", 1)[0]
                late[key] = ",".join([f"{sid}:cloudinit"] + opts)
            else:
                late[key] = str(value)
        elif vol.startswith("/") or ":" not in vol:
            notes.append(f"{key} not copied: {vol} is not a storage volume")
        else:
            sid, volname = vol.split(":", 1)
            disks.append(Disk(key=key, opts=opts, sid=sid, name=os.path.basename(volname)))
    return create, late, disks, notes


def boot_params(cfg, present):
    """boot/bootdisk limited to devices the new VM has."""
    out = {}
    boot = str(cfg.get("boot") or "")
    if boot.startswith("order="):
        devs = [d for d in boot[len("order="):].split(";") if d in present]
        if devs:
            out["boot"] = "order=" + ";".join(devs)
    elif boot:
        out["boot"] = boot
    if cfg.get("bootdisk") in present:
        out["bootdisk"] = cfg["bootdisk"]
    return out


def minimal_disks(dirs, vmid):
    disks = []
    for sid, (_, d) in sorted(dirs.items()):
        for name in sorted(os.listdir(d)):
            m = IMAGE_RE.match(name)
            if m and int(m.group(1)) == vmid:
                disks.append(Disk(key=f"scsi{len(disks)}", opts=[], sid=sid, name=name))
    return disks


def build_plan(backend, args):
    if not backend.local:
        raise PveError("pverestore reads image files and needs the pvesh backend (run it on the node)")
    node = args.local_node
    guests = {_int(r.get("vmid")): r for r in backend.get("/cluster/resources", type="vm") or []
              if r.get("type") in ("qemu", "lxc")}
    if args.newid in guests:
        raise PveError(f"--as {args.newid}: guest id is in use")
    storages = file_storages(backend, node)
    if args.storage and (args.storage not in storages
                         or "images" not in str(storages[args.storage].get("content") or "images").split(",")):
        raise PveError(f"--storage {args.storage}: not a file storage with content 'images' on {node} "
                       f"(supported: {', '.join(FILE_STORAGE_TYPES)})")
    dirs = source_dirs(args, storages, args.vmid)
    guest, notes = guests.get(args.vmid), []
    if guest and guest.get("type") == "lxc":
        raise PveError(f"{args.vmid} is a container: only VMs are supported")
    if guest and not args.no_config:
        cfg = backend.get(f"/nodes/{guest['node']}/qemu/{args.vmid}/config") or {}
        create, late, disks, notes = split_config(cfg, args.storage)
        name = f"restore-{guest.get('name') or args.vmid}"[:63]
    else:
        notes.append("no guest config used: minimal VM, check bios, machine, disk bus and memory before the start")
        cfg, create, late, name = {}, dict(MINIMAL_CONFIG), {}, f"restore-{args.vmid}"
        disks = minimal_disks(dirs, args.vmid)
        if disks:
            cfg["boot"] = f"order={disks[0].key}"
    for d in disks:
        src = dirs.get("") or dirs.get(d.sid)
        if src is None:
            d.error, d.missing = f"storage {d.sid} has no filer snapshot '{args.source}' with images of {args.vmid}", True
        else:
            resolve_disk(args, d, *src)
        d.target = args.storage or d.sid
        d.target_fmt = d.fmt if d.fmt in ("qcow2", "raw") else "qcow2"
        if not d.error and (d.target not in storages or "images" not in str(
                storages[d.target].get("content") or "images").split(",")):
            d.error = (f"target storage {d.target} is not a file storage with content 'images' on {node}: "
                       "use --storage") if d.target else "no target storage known: use --storage"
    if args.skip_missing:
        notes += [f"{d.key} skipped: {d.error}" for d in disks if d.missing]
        disks = [d for d in disks if not d.missing]
    used = {d.name for d in disks}
    for _, d in dirs.values():
        extra = sorted(n for n in os.listdir(d) if IMAGE_RE.match(n) and n not in used)
        if extra:
            notes.append(f"not in the guest config, not restored: {', '.join(extra)} (--no-config restores all images)")
    create["name"] = name
    stamp = time.strftime("%Y-%m-%d %H:%M")
    desc = f"Restored by pverestore on {stamp} from {args.source}" + (
        f", snapshot {args.snapshot}" if args.snapshot else "") + f", source VM {args.vmid}."
    create["description"] = desc + ("\n\n" + str(cfg["description"]) if cfg.get("description") else "")
    present = {d.key for d in disks} | set(late) | {k for k in create if NET_RE.match(k)}
    late.update(boot_params(cfg, present))
    return Plan(vmid=args.vmid, newid=args.newid, node=node, create=create, late=late, disks=disks, notes=notes)


# ---------------------------------------------------------------- commands

def print_plan(plan):
    print(C.bold(f"restore VM {plan.vmid} as new VM {plan.newid} '{plan.create['name']}' on {plan.node}"))
    rows = [[d.key, d.src or d.name, d.fmt or "-", fmt_size(d.size) if d.size else "-", d.state or "-",
             f"{d.target} ({d.target_fmt})", d.error or "ok"] for d in plan.disks]
    print_table(["DISK", "SOURCE", "FMT", "SIZE", "STATE", "TARGET", "STATUS"], rows,
                colorize=lambda i, cell, s: C.red(s) if i == 6 and cell != "ok" else s)
    for d in plan.disks:
        if d.snaps:
            print(f"{d.key}: snapshots in the source (--snapshot NAME): {', '.join(d.snaps)}")
    for k in sorted(plan.late):
        print(f"{k}: {plan.late[k]}")
    nets = sorted(k for k in plan.create if NET_RE.match(k))
    if nets:
        print(f"{', '.join(nets)}: same MAC, link_down=1")
    for n in plan.notes:
        print(C.yellow(n))


def convert(args, disk, dst):
    cmd = [args.qemu_img, "convert", "-p", "-n", "-f", disk.fmt, "-O", disk.target_fmt]
    if disk.snapshot:
        cmd += ["-l", f"snapshot.name={disk.snapshot}"]
    try:
        p = subprocess.run(cmd + [disk.src, dst], stderr=subprocess.PIPE, universal_newlines=True)
    except OSError as e:
        raise PveError(f"cannot run {args.qemu_img}: {e}") from e
    if p.returncode != 0:
        raise PveError(f"qemu-img convert {disk.src}: {p.stderr.strip() or 'exit code ' + str(p.returncode)}")


def volume_path(args, volid):
    try:
        p = subprocess.run([args.pvesm, "path", volid], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           universal_newlines=True)
    except OSError as e:
        raise PveError(f"cannot run {args.pvesm}: {e}") from e
    if p.returncode != 0 or not p.stdout.strip():
        raise PveError(f"pvesm path {volid}: {(p.stderr or p.stdout).strip()}")
    return p.stdout.strip()


def execute(backend, args, plan):
    """Create the VM, import the disks, attach them. Raises PveError; plan.disks[].volid shows what exists."""
    upid = backend.create(f"/nodes/{plan.node}/qemu", vmid=plan.newid, **plan.create)
    m = UPID_RE.search(str(upid or ""))
    if m:
        wait_task(backend, m.group(0), args.timeout)
    print(f"VM {plan.newid} created")
    for i, d in enumerate(plan.disks):
        filename = f"vm-{plan.newid}-disk-{i}.{d.target_fmt}"
        d.volid = str(backend.create(f"/nodes/{plan.node}/storage/{d.target}/content", vmid=plan.newid,
                                     filename=filename, size=-(-d.size // 1024), format=d.target_fmt))  # size: KiB
        print(f"{d.key}: {d.src} -> {d.volid} ({fmt_size(d.size)}, {d.state})", flush=True)
        convert(args, d, volume_path(args, d.volid))
    params = dict(plan.late)
    params.update({d.key: ",".join([d.volid] + d.opts) for d in plan.disks})
    backend.set(f"/nodes/{plan.node}/qemu/{plan.newid}/config", **params)


def cmd_vm(backend, args):
    plan = build_plan(backend, args)
    print_plan(plan)
    bad = [d for d in plan.disks if d.error]
    if bad or not plan.disks:
        hint = " (--skip-missing restores without the missing disks)" if any(d.missing for d in bad) else ""
        raise PveError(f"{len(bad)} disk(s) cannot be restored{hint}" if bad else "no disk to restore")
    if args.dry_run:
        print("dry run, nothing changed")
        return 0
    if not confirm(args):
        print("aborted")
        return 1
    try:
        execute(backend, args, plan)
    except (PveError, KeyboardInterrupt) as e:
        made = [d.volid for d in plan.disks if d.volid]
        print(C.red(f"restore failed: {e or 'interrupted'}"), file=sys.stderr)
        print(f"left behind: VM {plan.newid} (if created){', volumes ' + ', '.join(made) if made else ''}; "
              f"remove with 'qm destroy {plan.newid} --purge' after checking", file=sys.stderr)
        return 1
    print(C.green(f"VM {plan.newid} restored, not started, NICs are link_down"))
    print(f"next: qm start {plan.newid}, check it on the console, then enable the NICs or move the disks over")
    return 0


def cmd_sources(backend, args):
    if not backend.local:
        raise PveError("pverestore reads image files and needs the pvesh backend (run it on the node)")
    storages = file_storages(backend, args.local_node)
    now, rows = time.time(), []
    for sid, s in sorted(storages.items()):
        for name, _, d in snapshot_dirs(storage_root(s), args.vmid):
            images, chain, size, last = 0, 0, 0, 0
            for f in os.listdir(d):
                if not (IMAGE_RE.match(f) or CHAIN_FILE_RE.match(f)):
                    continue
                try:
                    st = os.stat(os.path.join(d, f))
                except OSError:
                    continue
                images, chain = images + bool(IMAGE_RE.match(f)), chain + bool(CHAIN_FILE_RE.match(f))
                size, last = size + st.st_blocks * 512, max(last, int(st.st_mtime))
            if images:
                rows.append({"storage": sid, "snapshot": name, "last_write": last, "disks": images,
                             "chain_files": chain, "size": size, "path": d})
    rows.sort(key=lambda r: (r["last_write"], r["storage"], r["snapshot"]))
    if args.json:
        print(json.dumps({"vmid": args.vmid, "sources": rows}, indent=2))
        return 0 if rows else 1
    if not rows:
        print(f"no filer snapshot with images of {args.vmid} on {len(storages)} file storage(s) "
              f"(looked in {', '.join(SNAPDIRS)})")
        return 1
    print_table(["STORAGE", "SNAPSHOT", "LAST WRITE", "AGE", "DISKS", "CHAIN FILES", "SIZE"],
                [[r["storage"], r["snapshot"], fmt_time(r["last_write"]), fmt_age(now - r["last_write"]),
                  r["disks"], r["chain_files"] or "", fmt_size(r["size"])] for r in rows])
    print(f"\n{len(rows)} source(s). plan a restore: pverestore vm {args.vmid} --from SNAPSHOT --as NEWID -n")
    return 0


def build_parser():
    common = common_parser()
    common.add_argument("--pvesm", default="pvesm", help=argparse.SUPPRESS)
    common.add_argument("--qemu-img", default="qemu-img", help=argparse.SUPPRESS)
    common.add_argument("--local-node", default=os.uname().nodename.split(".")[0], help=argparse.SUPPRESS)

    p = argparse.ArgumentParser(prog="pverestore", description=__doc__.splitlines()[0])
    p.add_argument("--version", action="version", version=f"pverestore {VERSION}")
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")
    sub.required = True

    sp = sub.add_parser("sources", parents=[common], help="list filer snapshots that hold images of a VM",
                        description="Looks in .snapshot (NetApp and other NFS filers) and .zfs/snapshot of every "
                                    "file storage of this node.")
    sp.add_argument("vmid", type=positive_int, metavar="VMID")
    sp.add_argument("--json", action="store_true", help="JSON output")

    sp = sub.add_parser("vm", parents=[common], help="restore old images into a new VM",
                        formatter_class=argparse.RawDescriptionHelpFormatter,
                        description="Creates VM NEWID from the config of VMID and a flat copy of each disk image.\n"
                                    "The new VM is not started, its NICs keep the MAC and get link_down=1.",
                        epilog="examples:\n"
                               "  pverestore vm 100 --from daily.2026-11-18_0010 --as 9100 -n\n"
                               "  pverestore vm 100 --from daily.2026-11-18_0010 --as 9100 --snapshot before-upgrade\n"
                               "  pverestore vm 100 --from /mnt/old/images/100 --as 9100 --storage nfs-prod\n"
                               "  pverestore vm 100 --from /mnt/old/images/100 --as 9100 --no-config")
    sp.add_argument("vmid", type=positive_int, metavar="VMID", help="source VM id (image names, config)")
    sp.add_argument("--from", dest="source", required=True, metavar="SNAPSHOT|DIR",
                    help="filer snapshot name (see 'sources'), or a directory with the images (contains '/')")
    sp.add_argument("--as", dest="newid", required=True, type=positive_int, metavar="NEWID", help="free VM id")
    sp.add_argument("--snapshot", metavar="NAME",
                    help="restore the state of this PVE snapshot (internal qcow2 or volume chain), not the last state")
    sp.add_argument("--storage", metavar="ID", help="target file storage for all disks (default: storage of each disk)")
    sp.add_argument("--no-config", action="store_true",
                    help="ignore the config of VMID: minimal VM with every image of the source as scsiN")
    sp.add_argument("--skip-missing", action="store_true", help="restore without disks that have no source image")
    sp.add_argument("-n", "--dry-run", action="store_true", help="show the plan only")
    sp.add_argument("-y", "--yes", action="store_true", help="no confirmation prompt")
    sp.add_argument("--timeout", type=positive_int, default=300, help="seconds for the VM create task (default 300)")
    return p


def main(argv=None):
    return run_main(build_parser(), {"sources": cmd_sources, "vm": cmd_vm}, {"sources"}, "pverestore", argv)


if __name__ == "__main__":
    sys.exit(main())
