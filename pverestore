# ---------------------------------------------------------------- guest config file (--replace)

SECTION_RE = re.compile(r"\[([^\]]*)\]\s*$")
SNAP_SECTION_RE = re.compile(r"[a-z][a-z0-9_-]+", re.I)


def parse_conf_sections(text):
    """Line-exact .conf split: {section: lines}, '' = main; render_conf restores the input."""
    sections, cur = {"": []}, ""
    for line in text.split("\n"):
        m = SECTION_RE.match(line)
        if not m:
            sections[cur].append(line)
            continue
        cur = m.group(1)
        if cur in sections:
            raise PveError(f"duplicate section [{cur}] in config, fix it by hand")
        sections[cur] = []
    return sections


def render_conf(sections):
    out = []
    for name, lines in sections.items():
        if name:
            out.append(f"[{name}]")
        out.extend(lines)
    return "\n".join(out)


def is_snapshot_section(name):
    return bool(SNAP_SECTION_RE.fullmatch(name)) and name.upper() != "PENDING"


def conf_get(lines, key):
    """Last value wins, like the PVE parser."""
    vals = [ln.split(":", 1)[1].strip() for ln in lines if ln.startswith(key + ":")]
    return vals[-1] if vals else None


def conf_set(lines, key, value):
    """Replaces key in place, appends after the last content line, value None removes it."""
    prefix = key + ":"
    pos = next((i for i, ln in enumerate(lines) if ln.startswith(prefix)), None)
    lines[:] = [ln for ln in lines if not ln.startswith(prefix)]
    if value is None:
        return
    if pos is None:
        pos = len(lines)
        while pos and not lines[pos - 1].strip():
            pos -= 1
    lines.insert(pos, f"{key}: {value}")


def read_conf(path):
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except OSError as e:
        raise PveError(f"cannot read guest config: {e}") from e
    return raw, parse_conf_sections(raw.decode("utf-8", "surrogateescape"))


@contextmanager
def config_lock(path, timeout=10):
    """Same flock as PVE lock_config: qm start waits while it is held."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as f:
        deadline = time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() > deadline:
                    raise PveError(f"config lock {path} held for {timeout}s, a PVE worker is active") from None
                time.sleep(0.1)
        yield


def write_conf(path, old, sections):
    """Caller holds config_lock. tmp + rename like PVE file_set_contents; refuses if the file changed."""
    current, _ = read_conf(path)
    if current != old:
        raise PveError(f"{path} changed since it was read, nothing written")
    tmp = f"{path}.tmp.{os.getpid()}"
    try:
        with open(tmp, "wb") as f:
            f.write(render_conf(sections).encode("utf-8", "surrogateescape"))
        os.replace(tmp, path)
    except OSError as e:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise PveError(f"cannot write {path} (no quorum?): {e}") from e


def size_text(n):
    """Bytes -> size= value as PVE writes it."""
    for unit, mult in (("T", 1 << 40), ("G", 1 << 30), ("M", 1 << 20), ("K", 1 << 10)):
        if n and n % mult == 0:
            return f"{n // mult}{unit}"
    return str(n)


# ---------------------------------------------------------------- storage and source

def storage_root(s):
    return s.get("path") or f"/mnt/pve/{s.get('storage')}"


def file_storages(backend, node):
    """File storages usable on this node, by id."""
    out = {}
    for s in backend.get("/storage") or []:
        nodes = s.get("nodes")
        if s.get("type") in FILE_STORAGE_TYPES and not _int(s.get("disable")) and (
                not nodes or node in nodes.split(",")):
            out[s["storage"]] = s
    return out


def snapshot_dirs(root, vmid):
    """(snapshot name, snapshot root, image dir) of every filer snapshot holding images of vmid."""
    out = []
    for sd in SNAPDIRS:
        base = os.path.join(root, sd)
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        for n in names:
            d = os.path.join(base, n, "images", str(vmid))
            if os.path.isdir(d):
                out.append((n, os.path.join(base, n), d))
    return out


def image_format(name):
    """By extension, never probed: a guest can write a qcow2 header into its raw disk."""
    ext = name.rsplit(".", 1)[-1] if "." in name else ""
    return ext if ext in ("qcow2", "vmdk") else "raw"


def image_info(args, path, fmt):
    cmd = [args.qemu_img, "info", "-U", "--backing-chain", "--output=json", "-f", fmt, path]
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True,
                           timeout=INFO_TIMEOUT)
        if p.returncode != 0:
            raise PveError(f"qemu-img info {path}: {p.stderr.strip()}")
        chain = json.loads(p.stdout)
        if not isinstance(chain, list) or not chain or "virtual-size" not in chain[0]:
            raise PveError(f"qemu-img info {path}: unexpected output")
        return chain
    except subprocess.TimeoutExpired as e:
        raise PveError(f"qemu-img info {path}: no answer after {INFO_TIMEOUT}s") from e
    except (OSError, ValueError) as e:
        raise PveError(f"qemu-img info {path}: {e}") from e


def inside(path, root):
    real, root = os.path.realpath(str(path)), os.path.realpath(root)
    return real == root or real.startswith(root + os.sep)


def source_dirs(args, storages, vmid):
    """{storage id or '': (root, image dir)}; '' = one directory given with --from for all disks."""
    if "/" in args.source:
        d = os.path.abspath(args.source)
        if not os.path.isdir(d):
            raise PveError(f"--from {args.source}: not a directory")
        parent = os.path.dirname(d)
        return {"": (os.path.dirname(parent) if os.path.basename(parent) == "images" else d, d)}
    out = {}
    for sid, s in sorted(storages.items()):
        for name, root, d in snapshot_dirs(storage_root(s), vmid):
            if name == args.source:
                out[sid] = (root, d)
                break
    if not out:
        raise PveError(f"filer snapshot '{args.source}' holds no images of {vmid} on any file storage of this node: "
                       f"see 'pverestore sources {vmid}'")
    return out


def chain_snapshots(d, name):
    try:
        found = (CHAIN_FILE_RE.match(f) for f in os.listdir(d))
    except OSError:
        return []
    return sorted(m.group(1) for m in found if m and m.group(2) == name)


def resolve_disk(args, disk, root, d):
    """Fills source path, format, size and the state to copy; sets disk.error instead of raising."""
    names = [disk.name] if "." in disk.name else [disk.name, disk.name + ".raw", disk.name + ".qcow2"]
    name = next((n for n in names if os.path.isfile(os.path.join(d, n))), None)
    if name is None:
        disk.error, disk.missing = f"{os.path.join(d, disk.name)} not found", True
        return
    disk.name, disk.fmt = name, image_format(name)
    path = os.path.join(d, name)
    chain_names = chain_snapshots(d, name)
    if args.snapshot in chain_names:
        path, disk.state = os.path.join(d, f"snap-{args.snapshot}-{name}"), f"chain file of '{args.snapshot}'"
    try:
        chain = image_info(args, path, disk.fmt)
    except PveError as e:
        disk.error = str(e)
        return
    outside = [c.get("filename") for c in chain if not inside(c.get("filename"), root)]
    if outside:
        disk.error = f"backing file {outside[0]} is outside the source {root}: result would mix two points in time"
        return
    internal = [s["name"] for s in chain[0].get("snapshots") or [] if s.get("name")]
    disk.snaps = sorted(set(internal) | set(chain_names))
    if args.snapshot and not disk.state:
        if args.snapshot not in internal:
            disk.error = f"{path}: no snapshot '{args.snapshot}' (has: {', '.join(disk.snaps) or 'none'})"
            return
        disk.snapshot, disk.state = args.snapshot, f"internal snapshot '{args.snapshot}'"
    elif not disk.state:
        disk.state = "active state" + (f", chain of {len(chain)} files" if len(chain) > 1 else "")
    disk.src, disk.size = path, int(chain[0]["virtual-size"])


# ---------------------------------------------------------------- config

def parse_drive(value):
    vol, _, rest = str(value).partition(",")
    return vol, [o for o in rest.split(",") if o and not o.startswith("size=")]


SIZE_UNITS = {"": 1, "K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}


def drive_size(value):
    """size=80G of a drive value -> bytes, 0 if absent or unreadable."""
    for o in str(value).split(","):
        m = re.fullmatch(r"size=(\d+(?:\.\d+)?)([KMGT]?)", o)
        if m:
            return int(float(m.group(1)) * SIZE_UNITS[m.group(2)])
    return 0


def parse_map(text):
    m = re.fullmatch(r"([a-z]+\d+)=([^/=\s]+)", text)
    if not m:
        raise argparse.ArgumentTypeError(f"invalid --map '{text}' (example: scsi0=vm-100-disk-0.qcow2)")
    return m.group(1), m.group(2)


def split_config(cfg, cloudinit_storage=None):
    """Guest config -> (create params, late drive params, disks, notes). Late = set after the import."""
    create, late, disks, notes = {}, {}, [], []
    for key in sorted(cfg):
        value = cfg[key]
        if key in DROP_KEYS or key in ("boot", "bootdisk"):
            if key == "cipassword":
                notes.append("cipassword not copied (the API returns it masked): set it again")
            continue
        if DROP_RE.match(key) or (re.match(r"^usb\d+$", key) and "host=" in str(value)):
            if not key.startswith("unused"):
                notes.append(f"{key} not copied: host device stays with the original VM")
            continue
        if NET_RE.match(key):
            parts = [p for p in str(value).split(",") if not p.startswith("link_down=")]
            create[key] = ",".join(parts + ["link_down=1"])
            continue
        if not DRIVE_RE.match(key):
            create[key] = value
            continue
        vol, opts = parse_drive(value)
        if "media=cdrom" in opts or vol in ("none", "cdrom"):
            if "cloudinit" in vol:
                sid = cloudinit_storage or vol.split(":", 1)[0]
                late[key] = ",".join([f"{sid}:cloudinit"] + opts)
            else:
                late[key] = str(value)
        elif vol.startswith("/") or ":" not in vol:
            notes.append(f"{key} not copied: {vol} is not a storage volume")
        else:
            sid, volname = vol.split(":", 1)
            disks.append(Disk(key=key, opts=opts, sid=sid, name=os.path.basename(volname), old=vol,
                              cfg_size=drive_size(value)))
    return create, late, disks, notes


def boot_params(cfg, present):
    """boot/bootdisk limited to devices the new VM has."""
    out = {}
    boot = str(cfg.get("boot") or "")
    if boot.startswith("order="):
        devs = [d for d in boot[len("order="):].split(";") if d in present]
        if devs:
            out["boot"] = "order=" + ";".join(devs)
    elif boot:
        out["boot"] = boot
    if cfg.get("bootdisk") in present:
        out["bootdisk"] = cfg["bootdisk"]
    return out


def minimal_disks(dirs, vmid):
    disks = []
    for sid, (_, d) in sorted(dirs.items()):
        for name in sorted(os.listdir(d)):
            m = IMAGE_RE.match(name)
            if m and int(m.group(1)) == vmid:
                disks.append(Disk(key=f"scsi{len(disks)}", opts=[], sid=sid, name=name))
    return disks


def match_renamed(args, disks, dirs):
    """Config names a volume the source lacks (renamed since, e.g. by --replace): take the one unclaimed image
    of the source with the drive's size= when no other missing disk wants it. Returns plan notes."""
    def src(x):
        return dirs.get("") or dirs.get(x.sid)

    notes, by_dir, cands = [], {}, {}
    for x in disks:
        if not x.missing or x.mapped or not src(x):
            continue
        d = src(x)[1]
        if d not in by_dir:
            claimed = {y.name for y in disks if not y.missing and src(y) == src(x)}
            by_dir[d] = []
            for n in sorted(os.listdir(d)):
                m = IMAGE_RE.match(n)
                if not m or int(m.group(1)) != args.vmid or n in claimed:
                    continue
                path = os.path.join(d, n)
                try:
                    by_dir[d].append((n, int(image_info(args, path, image_format(n))[0]["virtual-size"]),
                                      os.path.getmtime(path)))
                except PveError:
                    continue
        cands[x.key] = by_dir[d]
        if not x.cfg_size and x.old:  # no size= in the config: size of the current volume
            try:
                path = volume_path(args, x.old)
                x.cfg_size = int(image_info(args, path, image_format(path))[0]["virtual-size"])
            except PveError:
                pass
    def kib(n):  # import_disks allocates in KiB: a restored volume is the source rounded up
        return -(-n // 1024)

    hits = {x.key: [n for n, s, _ in cands[x.key] if x.cfg_size and kib(s) == kib(x.cfg_size)]
            for x in disks if x.key in cands}
    for x in disks:
        if x.key not in hits:
            continue
        h = hits[x.key]
        if len(h) == 1 and sum(h[0] in o for o in hits.values()) == 1:
            old, x.name, x.error, x.missing = x.name, h[0], "", False
            resolve_disk(args, x, *src(x))
            notes.append(f"{x.key}: {old} is not in the source, took {h[0]}: same size {fmt_size(x.cfg_size)} "
                         f"(--map {x.key}=IMAGE to choose another)")
        elif cands[x.key]:
            listed = ", ".join(f"{n} {fmt_size(s)} written {fmt_time(t)}" for n, s, t in cands[x.key])
            x.error += f"; source images not in the config: {listed}: choose with --map {x.key}=IMAGE"
    return notes


def check_replace(args, guest, node):
    """--replace changes the original VM: refuse every state where the swap could not finish cleanly."""
    if args.no_config:
        raise PveError("--replace needs the config of the VM: not with --no-config")
    if args.storage:
        raise PveError("--replace overwrites each disk where it is: not with --storage")
    if not guest or guest.get("type") != "qemu":
        raise PveError(f"--replace: VM {args.vmid} does not exist")
    if guest.get("node") != node:
        raise PveError(f"--replace: VM {args.vmid} is on node {guest.get('node')}, run pverestore there")
    if _int(guest.get("template")):
        raise PveError(f"--replace: {args.vmid} is a template")
    if guest.get("lock"):
        raise PveError(f"--replace: VM {args.vmid} is locked ({guest['lock']})")
    if guest.get("status") != "stopped" and not args.shutdown:
        raise PveError(f"--replace: VM {args.vmid} is {guest.get('status')}: stop it, or pass --shutdown "
                       "(shuts it down after the copy, before the swap)")


def free_disk_indexes(plan, count):
    """Unused N for vm-<vmid>-disk-N: not in the config, no file (image or chain file) on any file storage."""
    pat = re.compile(rf"(?:vm|base)-{plan.vmid}-disk-(\d+)")
    used = {int(n) for n in pat.findall(plan.config_text)}
    for s in plan.storages.values():
        try:
            names = os.listdir(os.path.join(storage_root(s), "images", str(plan.vmid)))
        except OSError:
            continue
        used |= {int(n) for f in names for n in pat.findall(f)}
    out, n = [], 0
    while len(out) < count:
        if n not in used:
            out.append(n)
        n += 1
    return out


def build_plan(backend, args):
    if not backend.local:
        raise PveError("pverestore reads image files and needs the pvesh backend (run it on the node)")
    node = args.local_node
    guests = {_int(r.get("vmid")): r for r in backend.get("/cluster/resources", type="vm") or []
              if r.get("type") in ("qemu", "lxc")}
    if bool(args.newid) == bool(args.replace):
        raise PveError("pass exactly one of --as NEWID (new VM) or --replace (swap the disks of VMID)")
    if args.replace:
        check_replace(args, guests.get(args.vmid), node)
        args.newid = args.vmid
    elif args.newid in guests:
        raise PveError(f"--as {args.newid}: guest id is in use")
    storages = file_storages(backend, node)
    if args.storage and (args.storage not in storages
                         or "images" not in str(storages[args.storage].get("content") or "images").split(",")):
        raise PveError(f"--storage {args.storage}: not a file storage with content 'images' on {node} "
                       f"(supported: {', '.join(FILE_STORAGE_TYPES)})")
    dirs = source_dirs(args, storages, args.vmid)
    guest, notes = guests.get(args.vmid), []
    if guest and guest.get("type") == "lxc":
        raise PveError(f"{args.vmid} is a container: only VMs are supported")
    if guest and not args.no_config:
        cfg = backend.get(f"/nodes/{guest['node']}/qemu/{args.vmid}/config") or {}
        create, late, disks, notes = split_config(cfg, args.storage)
        name = f"restore-{guest.get('name') or args.vmid}"[:63]
    else:
        notes.append("no guest config used: minimal VM, check bios, machine, disk bus and memory before the start")
        cfg, create, late, name = {}, dict(MINIMAL_CONFIG), {}, f"restore-{args.vmid}"
        disks = minimal_disks(dirs, args.vmid)
        if disks:
            cfg["boot"] = f"order={disks[0].key}"
    by_key = {d.key: d for d in disks}
    for key, image in args.map or []:
        if args.no_config or not guest:
            raise PveError("--map needs the guest config of the VM: not with --no-config")
        if key not in by_key:
            raise PveError(f"--map {key}: not a disk in the config of {args.vmid} (disks: {', '.join(by_key) or 'none'})")
        by_key[key].name, by_key[key].mapped = image, True
    for d in disks:
        src = dirs.get("") or dirs.get(d.sid)
        if src is None:
            d.error, d.missing = f"storage {d.sid} has no filer snapshot '{args.source}' with images of {args.vmid}", True
        else:
            resolve_disk(args, d, *src)
    matched = match_renamed(args, disks, dirs)
    for d in disks:
        d.target = args.storage or d.sid
        d.target_fmt = d.fmt if d.fmt in ("qcow2", "raw") else "qcow2"
        if args.replace:  # the volume keeps its name, so its format
            d.target_fmt = image_format(d.old)
            if d.target_fmt not in ("qcow2", "raw") and not d.error:
                d.error = f"{d.old}: in place only for qcow2 and raw volumes"
        if not d.error and (d.target not in storages or "images" not in str(
                storages[d.target].get("content") or "images").split(",")):
            d.error = (f"target storage {d.target} is not a file storage with content 'images' on {node}: "
                       "use --storage") if d.target else "no target storage known: use --storage"
    if args.skip_missing:
        notes += [f"{d.key} skipped: {d.error}" for d in disks if d.missing]
        disks = [d for d in disks if not d.missing]
    used = {d.name for d in disks}
    for _, d in dirs.values():
        extra = sorted(n for n in os.listdir(d) if IMAGE_RE.match(n) and n not in used)
        if extra:
            notes.append(f"not in the guest config, not restored: {', '.join(extra)} (--no-config restores all images)")
    create["name"] = name
    stamp = time.strftime("%Y-%m-%d %H:%M")
    desc = f"Restored by pverestore on {stamp} from {args.source}" + (
        f", snapshot {args.snapshot}" if args.snapshot else "") + f", source VM {args.vmid}."
    create["description"] = desc + ("\n\n" + str(cfg["description"]) if cfg.get("description") else "")
    present = {d.key for d in disks} | set(late) | {k for k in create if NET_RE.match(k)}
    late.update(boot_params(cfg, present))
    conf_path, snapshots = "", []
    if args.replace:
        conf_path = os.path.join(args.pve_dir, "nodes", node, "qemu-server", f"{args.vmid}.conf")
        snapshots = [n for n in read_conf(conf_path)[1] if is_snapshot_section(n)]
        # the VM keeps its config: only notes about the disks apply
        notes = [n for n in notes if "skipped" in n or "not restored" in n]
        notes += [f"{d.key} keeps its current content: restored and old disks will be from different points in time"
                  for d in split_config(cfg)[2] if d.key not in {x.key for x in disks}]
        notes += [f"{d.key}: size {fmt_size(d.cfg_size)} -> {fmt_size(d.size)}, as in the source"
                  for d in disks if d.size and d.cfg_size and -(-d.size // 1024) != -(-d.cfg_size // 1024)]
        if snapshots:
            notes.append(f"PVE snapshots of the VM removed with their chain files and RAM states: {', '.join(snapshots)}")
        unused = sorted(k for k in cfg if k.startswith("unused"))
        if unused:
            notes.append(f"{', '.join(unused)} not touched: 'pvedisk delete {args.vmid} --kind unused' removes them")
    notes = matched + notes
    return Plan(vmid=args.vmid, newid=args.newid, node=node, create=create, late=late, disks=disks, notes=notes,
                replace=args.replace, running=bool(guest) and guest.get("status") != "stopped", storages=storages,
                config_text=json.dumps(cfg), conf_path=conf_path, snapshots=snapshots)


