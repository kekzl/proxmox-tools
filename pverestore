FILE_STORAGE_TYPES = ("dir", "nfs", "cifs", "cephfs", "glusterfs")
SNAPDIRS = (".snapshot", os.path.join(".zfs", "snapshot"))  # NetApp/NFS filer, dir storage on ZFS
IMAGE_RE = re.compile(r"^(?:vm|base)-(\d+)-disk-(\d+)\.(qcow2|raw|vmdk)$")
CHAIN_FILE_RE = re.compile(r"^snap-(.+)-((?:vm|base)-\d+-disk-\d+\.qcow2)$")
DRIVE_RE = re.compile(r"^(?:(?:scsi|virtio|sata|ide)\d+|efidisk0|tpmstate0)$")
NET_RE = re.compile(r"^net\d+$")
# never copied: identity, state and values the API only returns masked
DROP_KEYS = ("digest", "vmgenid", "meta", "lock", "parent", "onboot", "protection", "template", "name",
             "description", "cipassword")
DROP_RE = re.compile(r"^(?:hostpci\d+|unused\d+)$")
MINIMAL_CONFIG = {"memory": 2048, "cores": 2, "scsihw": "virtio-scsi-single", "ostype": "l26"}
INFO_TIMEOUT = 60


