def print_plan(plan):
    if plan.replace:
        print(C.bold(f"OVERWRITE the disks of VM {plan.vmid} on {plan.node} in place"
                     + (", VM is running and will be shut down for the swap" if plan.running else "")))
    else:
        print(C.bold(f"restore VM {plan.vmid} as new VM {plan.newid} '{plan.create['name']}' on {plan.node}"))
    rows = [[d.key, d.src or d.name, d.fmt or "-", fmt_size(d.size) if d.size else "-", d.state or "-",
             d.old if plan.replace else f"{d.target} ({d.target_fmt})", d.error or "ok"] for d in plan.disks]
    print_table(["DISK", "SOURCE", "FMT", "SIZE", "STATE", "TARGET", "STATUS"], rows,
                colorize=lambda i, cell, s: C.red(s) if i == 6 and cell != "ok" else s)
    for d in plan.disks:
        if d.snaps:
            print(f"{d.key}: snapshots in the source (--snapshot NAME): {', '.join(d.snaps)}")
    for k in sorted(plan.late) if not plan.replace else ():
        print(f"{k}: {plan.late[k]}")
    nets = sorted(k for k in plan.create if NET_RE.match(k))
    if plan.replace:
        print("config, NICs and VM id stay as they are; vmgenid is renewed; the VM is left stopped")
    elif nets:
        print(f"{', '.join(nets)}: same MAC, link_down=1")
    for n in plan.notes:
        print(C.yellow(n))
    if plan.replace:
        print(C.red("the current content of these disks is lost: way back only from a newer filer snapshot"))


def convert(args, disk, dst):
    cmd = [args.qemu_img, "convert", "-p", "-n", "-f", disk.fmt, "-O", disk.target_fmt]
    if disk.snapshot:
        cmd += ["-l", f"snapshot.name={disk.snapshot}"]
    try:
        p = subprocess.run(cmd + [disk.src, dst], stderr=subprocess.PIPE, universal_newlines=True)
    except OSError as e:
        raise PveError(f"cannot run {args.qemu_img}: {e}") from e
    if p.returncode != 0:
        raise PveError(f"qemu-img convert {disk.src}: {p.stderr.strip() or 'exit code ' + str(p.returncode)}")


def volume_path(args, volid):
    try:
        p = subprocess.run([args.pvesm, "path", volid], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           universal_newlines=True)
    except OSError as e:
        raise PveError(f"cannot run {args.pvesm}: {e}") from e
    if p.returncode != 0 or not p.stdout.strip():
        raise PveError(f"pvesm path {volid}: {(p.stderr or p.stdout).strip()}")
    return p.stdout.strip()


def run_task(backend, result, timeout):
    m = UPID_RE.search(str(result or ""))
    if m:
        wait_task(backend, m.group(0), timeout)


def import_disks(backend, args, plan, indexes):
    for i, d in zip(indexes, plan.disks):
        filename = f"vm-{plan.newid}-disk-{i}.{d.target_fmt}"
        made = str(backend.create(f"/nodes/{plan.node}/storage/{d.target}/content", vmid=plan.newid,
                                  filename=filename, size=-(-d.size // 1024), format=d.target_fmt))  # size: KiB
        # file storages name the volume <storage>:<vmid>/<filename>: do not depend on how pvesh prints it
        expected = f"{d.target}:{plan.newid}/{filename}"
        d.volid = expected if expected in made else made
        print(f"{d.key}: {d.src} -> {d.volid}{' (staging)' if plan.replace else ''} ({fmt_size(d.size)}, {d.state})",
              flush=True)
        d.tmp_path = volume_path(args, d.volid)
        convert(args, d, d.tmp_path)


def execute(backend, args, plan):
    """Create the VM, import the disks, attach them. Raises PveError; plan.disks[].volid shows what exists."""
    run_task(backend, backend.create(f"/nodes/{plan.node}/qemu", vmid=plan.newid, **plan.create), args.timeout)
    print(f"VM {plan.newid} created")
    import_disks(backend, args, plan, range(len(plan.disks)))
    params = dict(plan.late)
    params.update({d.key: ",".join([d.volid] + d.opts) for d in plan.disks})
    backend.set(f"/nodes/{plan.node}/qemu/{plan.newid}/config", **params)


def vm_stopped(backend, base):
    return (backend.get(base + "/status/current") or {}).get("status") == "stopped"


def free_volume(args, volid):
    try:
        p = subprocess.run([args.pvesm, "free", volid], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           universal_newlines=True)
    except OSError as e:
        raise PveError(f"cannot run {args.pvesm}: {e}") from e
    if p.returncode != 0:
        raise PveError(f"pvesm free {volid}: {(p.stderr or p.stdout).strip()}")


@contextmanager
def no_interrupt():
    """Ctrl-C would leave config and files half swapped: ignored for the few renames."""
    old = signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        yield
    finally:
        signal.signal(signal.SIGINT, old)


def backup_conf(args, vmid, raw):
    try:
        os.makedirs(args.backup_dir, mode=0o700, exist_ok=True)
        path = os.path.join(args.backup_dir, f"{vmid}-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}.conf")
        with open(path, "wb") as f:
            f.write(raw)
        return path
    except OSError as e:
        raise PveError(f"cannot back up config, nothing changed: {e}") from e


def execute_replace(backend, args, plan):
    """Copy into staging volumes, then under the config lock: drop PVE snapshots from the config, rename each
    staging file onto the old volume, renew vmgenid. plan.phase tells how far it got."""
    base = f"/nodes/{plan.node}/qemu/{plan.vmid}"
    for d in plan.disks:
        d.old_path = volume_path(args, d.old)
    import_disks(backend, args, plan, free_disk_indexes(plan, len(plan.disks)))
    if not vm_stopped(backend, base):
        if not args.shutdown:
            raise PveError(f"VM {plan.vmid} was started during the copy")
        print(f"shutting down VM {plan.vmid} (timeout {args.timeout}s)", flush=True)
        run_task(backend, backend.create(base + "/status/shutdown", timeout=args.timeout), args.timeout + 60)
        if not vm_stopped(backend, base):
            raise PveError(f"VM {plan.vmid} is not stopped after the shutdown task")
    vmstates = []
    with config_lock(os.path.join(args.lock_dir, f"lock-{plan.vmid}.conf")), no_interrupt():
        if not vm_stopped(backend, base):  # qm start takes this lock: stopped now means stopped until the end
            raise PveError(f"VM {plan.vmid} was started before the swap")
        raw, secs = read_conf(plan.conf_path)
        main = secs[""]
        if conf_get(main, "lock"):
            raise PveError(f"VM {plan.vmid} is locked ({conf_get(main, 'lock')})")
        changed = [d.key for d in plan.disks if parse_drive(conf_get(main, d.key) or "")[0] != d.old]
        if changed:
            raise PveError(f"config of VM {plan.vmid} changed during the copy: {', '.join(changed)}")
        plan.snapshots = [n for n in secs if is_snapshot_section(n)]
        vmstates = [v for v in (conf_get(secs[n], "vmstate") for n in plan.snapshots) if v]
        plan.backup = backup_conf(args, plan.vmid, raw)
        for n in plan.snapshots:
            del secs[n]
        conf_set(main, "parent", None)
        # new generation id: the guest must see that it went back in time (AD, databases)
        conf_set(main, "vmgenid", str(uuid.uuid4()))
        for d in plan.disks:
            conf_set(main, d.key, ",".join([d.old] + d.opts + [f"size={size_text(-(-d.size // 1024) * 1024)}"]))
        write_conf(plan.conf_path, raw, secs)
        plan.phase = "config"
        for d in plan.disks:
            os.replace(d.tmp_path, d.old_path)
            d.swapped = True
        plan.phase = "done"
    # the chain files of the dropped snapshots backed the old content only
    for d in plan.disks:
        folder, name = os.path.split(d.old_path)
        for s in plan.snapshots:
            p = os.path.join(folder, f"snap-{s}-{name}")
            try:
                if os.path.lexists(p):
                    os.unlink(p)
            except OSError as e:
                plan.leftovers.append(f"{p}: {e.strerror}")
    for v in vmstates:
        try:
            free_volume(args, v)
        except PveError as e:
            plan.leftovers.append(str(e))


def drop_staging(plan):
    """Staging files not renamed yet: nothing references them."""
    left = []
    for d in plan.disks:
        if d.tmp_path and not d.swapped:
            try:
                os.unlink(d.tmp_path)
            except FileNotFoundError:
                pass
            except OSError:
                left.append(d.volid)
    return left


def report_failure(plan, e):
    made = [d for d in plan.disks if d.volid]
    print(C.red(f"restore failed: {e or 'interrupted'}"), file=sys.stderr)
    if not plan.replace:
        print(f"left behind: VM {plan.newid} (if created){', volumes ' + ', '.join(d.volid for d in made) if made else ''}"
              f"; remove with 'qm destroy {plan.newid} --purge' after checking", file=sys.stderr)
    elif plan.phase == "config":
        print(f"VM {plan.vmid}: config written (backup {plan.backup}), not every disk was swapped. "
              "finish by hand, then delete the snap-* chain files of the swapped disks:", file=sys.stderr)
        for d in plan.disks:
            if not d.swapped:
                print(f"  mv {d.tmp_path} {d.old_path}", file=sys.stderr)
    else:
        left = drop_staging(plan)
        print(f"VM {plan.vmid} is unchanged" + (
            f"; staging volumes not removed: {', '.join(left)}" if left else ""), file=sys.stderr)


def cmd_vm(backend, args):
    plan = build_plan(backend, args)
    print_plan(plan)
    bad = [d for d in plan.disks if d.error]
    if bad or not plan.disks:
        hint = " (--skip-missing restores without the missing disks)" if any(d.missing for d in bad) else ""
        raise PveError(f"{len(bad)} disk(s) cannot be restored{hint}" if bad else "no disk to restore")
    if args.dry_run:
        print("dry run, nothing changed")
        return 0
    if not confirm(args):
        print("aborted")
        return 1
    try:
        (execute_replace if plan.replace else execute)(backend, args, plan)
    except (PveError, OSError, KeyboardInterrupt) as e:
        report_failure(plan, e)
        return 1
    if plan.replace:
        print(C.green(f"VM {plan.vmid}: {len(plan.disks)} disk(s) overwritten in place, VM is stopped"))
        for d in plan.disks:
            print(f"  {d.key}: {d.old} <- {d.src}")
        if plan.snapshots:
            print(f"PVE snapshots removed: {', '.join(plan.snapshots)}")
        print(f"config backup: {plan.backup}")
        for x in plan.leftovers:
            print(C.yellow(f"not removed: {x}"))
        print(f"next: qm start {plan.vmid}")
        return 0
    print(C.green(f"VM {plan.newid} restored, not started, NICs are link_down"))
    print(f"next: qm start {plan.newid}, check it on the console, then enable the NICs or move the disks over")
    return 0


def cmd_sources(backend, args):
    if not backend.local:
        raise PveError("pverestore reads image files and needs the pvesh backend (run it on the node)")
    storages = file_storages(backend, args.local_node)
    now, rows = time.time(), []
    for sid, s in sorted(storages.items()):
        for name, _, d in snapshot_dirs(storage_root(s), args.vmid):
            images, chain, size, last = 0, 0, 0, 0
            for f in os.listdir(d):
                if not (IMAGE_RE.match(f) or CHAIN_FILE_RE.match(f)):
                    continue
                try:
                    st = os.stat(os.path.join(d, f))
                except OSError:
                    continue
                images, chain = images + bool(IMAGE_RE.match(f)), chain + bool(CHAIN_FILE_RE.match(f))
                size, last = size + st.st_blocks * 512, max(last, int(st.st_mtime))
            if images:
                rows.append({"storage": sid, "snapshot": name, "last_write": last, "disks": images,
                             "chain_files": chain, "size": size, "path": d})
    rows.sort(key=lambda r: (r["last_write"], r["storage"], r["snapshot"]))
    if args.json:
        print(json.dumps({"vmid": args.vmid, "sources": rows}, indent=2))
        return 0 if rows else 1
    if not rows:
        print(f"no filer snapshot with images of {args.vmid} on {len(storages)} file storage(s) "
              f"(looked in {', '.join(SNAPDIRS)})")
        return 1
    print_table(["STORAGE", "SNAPSHOT", "LAST WRITE", "AGE", "DISKS", "CHAIN FILES", "SIZE"],
                [[r["storage"], r["snapshot"], fmt_time(r["last_write"]), fmt_age(now - r["last_write"]),
                  r["disks"], r["chain_files"] or "", fmt_size(r["size"])] for r in rows])
    print(f"\n{len(rows)} source(s). plan a restore: pverestore vm {args.vmid} --from SNAPSHOT --as NEWID -n")
    return 0


def build_parser():
    common = common_parser()
    common.add_argument("--pvesm", default="pvesm", help=argparse.SUPPRESS)
    common.add_argument("--qemu-img", default="qemu-img", help=argparse.SUPPRESS)
    common.add_argument("--local-node", default=os.uname().nodename.split(".")[0], help=argparse.SUPPRESS)
    common.add_argument("--pve-dir", default="/etc/pve", help=argparse.SUPPRESS)
    common.add_argument("--lock-dir", default="/var/lock/qemu-server", help=argparse.SUPPRESS)
    common.add_argument("--backup-dir", default="/var/backups/pverestore",
                        help="--replace: config backups (default /var/backups/pverestore)")

    p = argparse.ArgumentParser(prog="pverestore", description=__doc__.splitlines()[0])
    p.add_argument("--version", action="version", version=f"pverestore {VERSION}")
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")
    sub.required = True

    sp = sub.add_parser("sources", parents=[common], help="list filer snapshots that hold images of a VM",
                        description="Looks in .snapshot (NetApp and other NFS filers) and .zfs/snapshot of every "
                                    "file storage of this node.")
    sp.add_argument("vmid", type=positive_int, metavar="VMID")
    sp.add_argument("--json", action="store_true", help="JSON output")

    sp = sub.add_parser("vm", parents=[common], help="restore old images into a new VM",
                        formatter_class=argparse.RawDescriptionHelpFormatter,
                        description="Creates VM NEWID from the config of VMID and a flat copy of each disk image.\n"
                                    "The new VM is not started, its NICs keep the MAC and get link_down=1.\n"
                                    "--replace instead overwrites the disks of VMID in place, same volume names;\n"
                                    "its PVE snapshots are removed, the old content is lost.",
                        epilog="examples:\n"
                               "  pverestore vm 100 --from daily.2026-11-18_0010 --as 9100 -n\n"
                               "  pverestore vm 100 --from daily.2026-11-18_0010 --as 9100 --snapshot before-upgrade\n"
                               "  pverestore vm 100 --from /mnt/old/images/100 --as 9100 --storage nfs-prod\n"
                               "  pverestore vm 100 --from /mnt/old/images/100 --as 9100 --no-config\n"
                               "  pverestore vm 100 --from daily.2026-11-18_0010 --replace --shutdown -n")
    sp.add_argument("vmid", type=positive_int, metavar="VMID", help="source VM id (image names, config)")
    sp.add_argument("--from", dest="source", required=True, metavar="SNAPSHOT|DIR",
                    help="filer snapshot name (see 'sources'), or a directory with the images (contains '/')")
    sp.add_argument("--as", dest="newid", type=positive_int, metavar="NEWID", help="restore into a new VM with this free id")
    sp.add_argument("--replace", action="store_true",
                    help="overwrite the disks of VMID in place: config and id stay, PVE snapshots of the VM are removed")
    sp.add_argument("--shutdown", action="store_true",
                    help="with --replace on a running VM: shut it down after the copy, before the swap")
    sp.add_argument("--snapshot", metavar="NAME",
                    help="restore the state of this PVE snapshot (internal qcow2 or volume chain), not the last state")
    sp.add_argument("--storage", metavar="ID", help="target file storage for all disks (default: storage of each disk)")
    sp.add_argument("--no-config", action="store_true",
                    help="ignore the config of VMID: minimal VM with every image of the source as scsiN")
    sp.add_argument("--map", action="append", type=parse_map, metavar="KEY=IMAGE",
                    help="take this source image for drive KEY (repeatable), e.g. scsi0=vm-100-disk-0.qcow2; "
                         "default: the image the config names, else the one unclaimed image of the same size")
    sp.add_argument("--skip-missing", action="store_true", help="restore without disks that have no source image")
    sp.add_argument("-n", "--dry-run", action="store_true", help="show the plan only")
    sp.add_argument("-y", "--yes", action="store_true", help="no confirmation prompt")
    sp.add_argument("--timeout", type=positive_int, default=300,
                    help="seconds for the VM create task or the shutdown (default 300)")
    return p


def main(argv=None):
    return run_main(build_parser(), {"sources": cmd_sources, "vm": cmd_vm}, {"sources"}, "pverestore", argv)


if __name__ == "__main__":
    sys.exit(main())
