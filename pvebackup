@dataclass
class Backup:
    storage: str
    volid: str
    vmid: int | None
    ctime: int | None
    size: int | None
    verify: str | None
    protected: bool


@dataclass
class GuestB:
    vmid: int
    node: str
    type: str
    name: str = ""
    status: str = ""
    template: bool = False
    covered: bool | None = None
    backups: list = field(default_factory=list)

    @property
    def last(self):
        return self.backups[-1] if self.backups else None


@dataclass
class Finding:
    severity: str
    vmid: int | None
    name: str
    check: str
    detail: str


def collect(backend, args, now):
    """Returns (guests filtered, orphan backups by vmid, findings from collection, storages scanned)."""
    res = backend.get("/cluster/resources") or []
    guests, all_vmids, storages, nodes = {}, set(), {}, []
    for r in res:
        t = r.get("type")
        if t in ("qemu", "lxc"):
            vmid = _int(r.get("vmid"))
            if vmid is None:
                continue
            all_vmids.add(vmid)
            if not guest_filtered(args, vmid, r.get("node"), t, r.get("name")):
                continue
            if _int(r.get("template")) and not args.templates:
                continue
            guests[vmid] = GuestB(vmid, r.get("node") or "", t, r.get("name") or "", r.get("status") or "",
                                  bool(_int(r.get("template"))))
        elif t == "storage" and r.get("storage") and r.get("node"):
            storages[(r["node"], r["storage"])] = r
        elif t == "node" and r.get("status") == "online":
            nodes.append(r.get("node"))
    findings = []

    targets, shared_done, shared_wanted = [], set(), set()
    for (node, st), r in sorted(storages.items()):
        if "backup" not in str(r.get("content") or "").split(","):
            continue
        if args.storage and st not in args.storage:
            continue
        shared = bool(_int(r.get("shared")))
        if shared:
            shared_wanted.add(st)
        if r.get("status") != "available":
            if not shared:
                findings.append(Finding("INFO", None, "", "scan", f"storage {st} on {node} status "
                                        f"'{r.get('status')}', its backups are not counted"))
            continue
        if shared and st in shared_done:
            continue
        if shared:
            shared_done.add(st)
        targets.append((node, st, r))
        disk, maxdisk = _int(r.get("disk")), _int(r.get("maxdisk"))
        if args.max_usage and disk is not None and maxdisk:
            pct = 100.0 * disk / maxdisk
            if pct > args.max_usage:
                findings.append(Finding("WARN", None, "", "usage", f"storage {st}" + ("" if shared else f" on {node}")
                                        + f" {pct:.0f}% full ({fmt_size(disk)} / {fmt_size(maxdisk)})"))
    for st in sorted(shared_wanted - shared_done):
        findings.append(Finding("INFO", None, "", "scan",
                                f"shared storage {st} not available on any node, its backups are not counted"))

    def fetch(t):
        node, st, _ = t
        try:
            return st, backend.get(f"/nodes/{node}/storage/{st}/content", content="backup") or [], None
        except PveError as e:
            return st, [], f"{st} on {node}: {e}"

    with ThreadPoolExecutor(max_workers=args.jobs) as ex:
        listed = list(ex.map(fetch, targets))
    orphans = {}
    for st, entries, err in listed:
        if err:
            findings.append(Finding("WARN", None, "", "scan", f"cannot list {err}"))
            continue
        for e in entries:
            if e.get("content", "backup") != "backup":
                continue
            ver = e.get("verification")
            b = Backup(st, str(e.get("volid") or ""), _int(e.get("vmid")), _int(e.get("ctime")), _int(e.get("size")),
                       ver.get("state") if isinstance(ver, dict) else None, bool(_int(e.get("protected"))))
            if b.vmid in guests:
                guests[b.vmid].backups.append(b)
            elif b.vmid is not None and b.vmid not in all_vmids:
                orphans.setdefault(b.vmid, []).append(b)
    for g in guests.values():
        g.backups.sort(key=lambda b: (b.ctime or 0, b.volid))

    try:
        not_backed = {_int(e.get("vmid")) for e in backend.get("/cluster/backup-info/not-backed-up") or []}
        for g in guests.values():
            g.covered = g.vmid not in not_backed
    except PveError as e:
        findings.append(Finding("INFO", None, "", "jobs", f"job coverage unknown: {e}"))
    try:
        for j in backend.get("/cluster/backup") or []:
            if "enabled" in j and not _int(j.get("enabled")):
                findings.append(Finding("INFO", None, "", "jobs",
                                        f"backup job {j.get('id')} disabled ({j.get('schedule') or '-'})"))
    except PveError:
        pass

    since = int(now - args.failed_since) if args.failed_since else 0
    if since:
        def tasks_of(node):
            try:
                return node, backend.get(f"/nodes/{node}/tasks", typefilter="vzdump", errors=1, since=since,
                                         limit=500) or [], None
            except PveError as e:
                return node, [], str(e)

        unfiltered = args.guests is None and not args.node and not args.type and not args.name
        with ThreadPoolExecutor(max_workers=args.jobs) as ex:
            for node, tasks, err in ex.map(tasks_of, sorted(n for n in nodes if not args.node or n in args.node)):
                if err:
                    findings.append(Finding("INFO", None, "", "tasks", f"cannot read tasks of {node}: {err}"))
                for t in tasks:
                    status = str(t.get("status") or "")
                    if not t.get("endtime") or status == "OK" or status.startswith("WARNINGS"):
                        continue
                    vmid = _int(t.get("id"))
                    g = guests.get(vmid)
                    if vmid is not None and g is None and (vmid in all_vmids or not unfiltered):
                        continue  # guest filtered out or template
                    detail = f"vzdump on {node} at {fmt_time(_int(t.get('starttime')))}: {status}"
                    if g and g.last and (g.last.ctime or 0) > (_int(t.get("endtime")) or 0):
                        findings.append(Finding("INFO", vmid, g.name, "failed", detail + ", newer backup exists"))
                    else:
                        findings.append(Finding("WARN", vmid, g.name if g else "", "failed", detail))
    return list(guests.values()), orphans, findings, len(targets)


def run_checks(guests, orphans, args, now):
    out = []
    for g in sorted(guests, key=lambda g: g.vmid):
        def add(sev, check, detail):
            out.append(Finding(sev, g.vmid, g.name, check, detail))

        last = g.last
        if g.covered is False:
            add("WARN", "nojob", "not in any backup job" + (f", last backup {fmt_age(now - last.ctime)} old"
                                                          if last and last.ctime else ""))
        if not last:
            if g.covered:
                add("ERROR", "none", "in a backup job but no backup on any scanned storage")
            elif g.covered is None:
                add("WARN", "none", "no backup on any scanned storage")
            continue
        if args.max_age and last.ctime and now - last.ctime > args.max_age:
            add("WARN", "age", f"last backup {fmt_age(now - last.ctime)} old (> {fmt_age(args.max_age)}): "
                               f"{last.volid}")
        if last.verify == "failed":
            add("ERROR", "verify", f"latest backup failed verification: {last.volid}")
        failed_old = sum(1 for b in g.backups[:-1] if b.verify == "failed")
        if failed_old:
            add("WARN", "verify", f"{failed_old} older backup(s) failed verification")
        if args.min_count and len(g.backups) < args.min_count:
            add("WARN", "count", f"{len(g.backups)} backup(s) (< {args.min_count})")
    unfiltered = args.guests is None and not args.node and not args.type and not args.name
    if unfiltered:
        for vmid, bs in sorted(orphans.items()):
            out.append(Finding("INFO", vmid, "", "deleted-guest",
                               f"{len(bs)} backup(s), {fmt_size(sum(b.size or 0 for b in bs))}, guest no longer "
                               f"exists, newest {fmt_time(max(b.ctime or 0 for b in bs))}"))
    return out


def cmd_check(backend, args):
    now = time.time()
    guests, orphans, findings, nstorages = collect(backend, args, now)
    findings += run_checks(guests, orphans, args, now)
    if args.quiet:
        findings = [f for f in findings if f.severity != "INFO"]
    findings.sort(key=lambda f: (SEVERITY_RANK[f.severity], f.vmid or 0, f.check))
    counts = severity_counts(findings)
    nbackups = sum(len(g.backups) for g in guests)
    if args.json:
        print(json.dumps({"summary": {"guests": len(guests), "backups": nbackups, "storages": nstorages,
                                      **{k.lower(): v for k, v in counts.items()}},
                          "findings": [asdict(f) for f in findings]}, indent=2))
    else:
        if findings:
            print_findings(findings, [("SEV", lambda f: f.severity),
                                      ("VMID", lambda f: f.vmid if f.vmid is not None else "-"),
                                      ("NAME", lambda f: f.name or "-"), ("CHECK", lambda f: f.check),
                                      ("DETAIL", lambda f: f.detail)])
            print()
        print(f"{len(guests)} guest(s), {nbackups} backup(s) on {nstorages} storage(s): {counts['ERROR']} error, "
              f"{counts['WARN']} warn, {counts['INFO']} info")
    return exit_code(counts, args.fail_on)


def cmd_list(backend, args):
    now = time.time()
    args.failed_since = 0
    guests, _, findings, nstorages = collect(backend, args, now)
    guests.sort(key=lambda g: g.vmid)
    if args.json:
        print(json.dumps([{**{k: v for k, v in asdict(g).items() if k != "backups"},
                           "backups": [asdict(b) for b in g.backups]} for g in guests], indent=2))
        return 0
    rows = []
    for g in guests:
        last = g.last
        job = {True: "yes", False: "no", None: "?"}[g.covered]
        rows.append([g.vmid, g.name, g.node, job, fmt_time(last.ctime) if last else "-",
                     fmt_age(now - last.ctime) if last and last.ctime else "-", len(g.backups),
                     fmt_size(sum(b.size or 0 for b in g.backups)) if g.backups else "-",
                     ",".join(sorted({b.storage for b in g.backups})) or "-",
                     (last.verify or "-") if last else "-"])
    print_table(["VMID", "NAME", "NODE", "JOB", "LAST", "AGE", "COUNT", "SIZE", "STORAGE", "VERIFY"], rows)
    for f in findings:
        if f.check == "scan":
            print(C.yellow(f"warning: {f.detail}"), file=sys.stderr)
    print(f"\n{len(guests)} guest(s), {sum(len(g.backups) for g in guests)} backup(s) on {nstorages} storage(s)")
    return 0


def build_parser():
    common, filt = common_parser(), filter_parser()
    filt.add_argument("--storage", action="append", help="only this backup storage (repeatable)")
    filt.add_argument("--templates", action="store_true", help="include templates")
    p = argparse.ArgumentParser(prog="pvebackup", description=__doc__.splitlines()[0],
                                epilog="GUESTS: 100 | 100,101 | 200-210 | all")
    p.add_argument("--version", action="version", version=f"pvebackup {VERSION}")
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")
    sub.required = True

    sp = sub.add_parser("list", parents=[common, filt], help="last backup, count, size, verify state per guest")
    sp.add_argument("guests", nargs="?", default="all", type=parse_idspec, metavar="GUESTS")
    sp.add_argument("--json", action="store_true", help="JSON output")
    sp.set_defaults(max_usage=0)

    sp = sub.add_parser("check", parents=[common, filt], help="audit backups, exit 1 on findings",
                        description="Checks: not in any job, no backup, last backup age, PBS verification, "
                                    "backup count, failed vzdump tasks, storage usage, disabled jobs, backups "
                                    "of deleted guests.")
    sp.add_argument("guests", nargs="?", default="all", type=parse_idspec, metavar="GUESTS")
    sp.add_argument("--max-age", type=parse_age, default=parse_age("26h"),
                    help="warn if last backup older (default 26h, 0=off)")
    sp.add_argument("--min-count", type=int, default=0, help="warn below backups per guest (default 0=off)")
    sp.add_argument("--failed-since", type=parse_age, default=parse_age("7d"),
                    help="report failed vzdump tasks of this period (default 7d, 0=off)")
    sp.add_argument("--max-usage", type=float, default=85.0, help="warn above backup storage usage %% (default 85)")
    sp.add_argument("--fail-on", choices=["warn", "error", "never"], default="warn",
                    help="exit 1 threshold (default warn)")
    sp.add_argument("-q", "--quiet", action="store_true", help="hide INFO findings")
    sp.add_argument("--json", action="store_true", help="JSON output")
    return p


def main(argv=None):
    return run_main(build_parser(), {"list": cmd_list, "check": cmd_check}, {"list", "check"}, "pvebackup", argv)


if __name__ == "__main__":
    sys.exit(main())
