# node endpoint -> checks that need it
ENDPOINTS = {"version": ("version",), "status": ("kernel", "rootfs"), "time": ("time",),
             "apt/versions": ("kernel",), "apt/update": ("updates",), "certificates/info": ("cert",),
             "disks/list": ("smart",), "disks/zfs": ("zfs",), "disks/lvmthin": ("thin",)}
LIST_ENDPOINTS = ("version", "status", "apt/versions", "apt/update", "certificates/info")
CHECKS = ("offline", "quorum", "fetch", "version", "kernel", "updates", "cert", "rootfs", "zfs", "thin", "smart",
          "time", "ceph")
KERNEL_PKG_RE = re.compile(r"^(?:pve|proxmox)-kernel-(\d+\.\d+\.\d+-\d+-pve)(?:-signed)?$")
SMART_OK = {"", "PASSED", "OK", "UNKNOWN", "N/A"}
CEPH_SEV = {"HEALTH_WARN": "WARN", "HEALTH_ERR": "ERROR"}
FULL_PCT = 95  # usage at or above this is ERROR, regardless of --max-usage


@dataclass
class Finding:
    severity: str
    node: str
    check: str
    detail: str


@dataclass
class Node:
    name: str
    online: bool
    data: dict = field(default_factory=dict)      # endpoint -> response
    errors: dict = field(default_factory=dict)    # endpoint -> message
    offset: float | None = None                   # node clock minus local request midpoint, seconds

    def get(self, ep, default=None):
        v = self.data.get(ep)
        return default if v is None else v


def kernel_key(release):
    return tuple(int(x) for x in re.findall(r"\d+", release or ""))


def running_kernel(status):
    ck = status.get("current-kernel")
    if isinstance(ck, dict) and ck.get("release"):
        return ck["release"]
    parts = str(status.get("kversion") or "").split()  # PVE 7: "Linux 5.15.102-1-pve #1 SMP ..."
    return parts[1] if len(parts) > 1 else None


def newest_kernel(versions):
    rel = []
    for e in versions or []:
        m = KERNEL_PKG_RE.match(str(e.get("Package") or ""))
        if m and str(e.get("CurrentState") or "Installed") == "Installed":
            rel.append(m.group(1))
    return max(rel, key=kernel_key) if rel else None


def pct(used, total):
    used, total = _int(used), _int(total)
    return 100.0 * used / total if used is not None and total else None


def ceph_expected(storage_cfg):
    """Hyperconverged Ceph: an rbd/cephfs storage without monhost uses the local cluster."""
    return any(c.get("type") in ("rbd", "cephfs") and not c.get("monhost") for c in storage_cfg or [])


def collect(backend, args, endpoints):
    """Returns (nodes by name, cluster-level findings)."""
    findings = []
    nodes = {}
    for r in backend.get("/cluster/resources", type="node") or []:
        name = r.get("node")
        if r.get("type") == "node" and name and (not args.node or name in args.node):
            nodes[name] = Node(name, r.get("status") == "online")
    missing = sorted(set(args.node or []) - set(nodes))
    if missing:
        raise PveError(f"node(s) not found: {', '.join(missing)}")
    try:
        status = backend.get("/cluster/status") or []
    except PveError as e:
        status = []
        findings.append(Finding("WARN", "", "fetch", f"/cluster/status: {e}"))
    for e in status:
        if e.get("type") == "cluster" and "quorate" in e and not _int(e.get("quorate")):
            findings.append(Finding("ERROR", "", "quorum", f"cluster '{e.get('name')}' not quorate: "
                                                           f"/etc/pve is read-only, no guest start/migration"))
        if e.get("type") == "node" and e.get("name") in nodes and "online" in e:
            nodes[e["name"]].online = bool(_int(e.get("online")))

    def fetch(job):
        node, ep = job
        t0 = time.time()
        try:
            out = backend.get(f"/nodes/{node.name}/{ep}")
        except PveError as e:
            node.errors[ep] = str(e)
            return
        t1 = time.time()
        node.data[ep] = out
        if ep == "time" and isinstance(out, dict) and _int(out.get("time")) is not None:
            node.offset = _int(out["time"]) - (t0 + t1) / 2

    jobs = [(n, ep) for n in nodes.values() if n.online for ep in endpoints]
    with ThreadPoolExecutor(max_workers=args.jobs) as ex:
        list(ex.map(fetch, jobs))

    if "ceph" not in getattr(args, "skip", ["ceph"]):
        try:
            expected = ceph_expected(backend.get("/storage"))
        except PveError:
            expected = False
        if expected:
            try:
                health = (backend.get("/cluster/ceph/status") or {}).get("health") or {}
                sev = CEPH_SEV.get(health.get("status"))
                if sev:
                    msgs = [str((c.get("summary") or {}).get("message") or k)
                            for k, c in sorted((health.get("checks") or {}).items())]
                    findings.append(Finding(sev, "", "ceph", f"{health['status']}: " + "; ".join(msgs[:5])))
            except (PveError, AttributeError) as e:
                findings.append(Finding("WARN", "", "fetch", f"/cluster/ceph/status: {e}"))
    return nodes, findings


def run_checks(nodes, args, now):
    out = []
    for n in sorted(nodes.values(), key=lambda n: n.name):
        def add(sev, check, detail):
            out.append(Finding(sev, n.name, check, detail))

        def usage(check, what, used, total):
            p = pct(used, total)
            if p is None:
                return
            text = f"{what} {p:.0f}% used ({fmt_size(_int(used))} / {fmt_size(_int(total))})"
            if p >= FULL_PCT:
                add("ERROR", check, text)
            elif args.max_usage and p > args.max_usage:
                add("WARN", check, text)

        if not n.online:
            add("WARN", "offline", "node offline, not checked")
            continue
        for ep, err in sorted(n.errors.items()):
            add("WARN", "fetch", f"{ep}: {err}")
        st = n.get("status", {})
        run, new = running_kernel(st), newest_kernel(n.get("apt/versions"))
        if run and new and kernel_key(new) > kernel_key(run):
            add("WARN", "kernel", f"running {run}, newest installed {new}: reboot pending")
        rootfs = st.get("rootfs") or {}
        usage("rootfs", "root filesystem", rootfs.get("used"), rootfs.get("total"))
        ups = n.get("apt/update", [])
        if ups:
            names = sorted(str(u.get("Package") or "?") for u in ups)
            add("INFO", "updates", f"{len(names)} update(s) pending: " + ", ".join(names[:4])
                + (", ..." if len(names) > 4 else ""))
        for c in n.get("certificates/info", []):
            na = _int(c.get("notafter"))
            if na is None:
                continue
            if na <= now:
                add("ERROR", "cert", f"{c.get('filename')} expired {fmt_time(na)}")
            elif args.cert_warn and na - now < args.cert_warn:
                add("WARN", "cert", f"{c.get('filename')} expires {fmt_time(na)} (in {fmt_age(na - now)})")
        for p in n.get("disks/zfs", []):
            health = str(p.get("health") or "?")
            if health != "ONLINE":
                add("ERROR", "zfs", f"pool {p.get('name')} {health}: zpool status -x")
            usage("zfs", f"pool {p.get('name')}", p.get("alloc"), p.get("size"))
        for t in n.get("disks/lvmthin", []):
            name = f"{t.get('vg')}/{t.get('lv')}"
            usage("thin", f"thin pool {name} data", t.get("used"), t.get("lv_size"))
            usage("thin", f"thin pool {name} metadata", t.get("metadata_used"), t.get("metadata_size"))
        for d in n.get("disks/list", []):
            health = str(d.get("health") or "").upper()
            if health not in SMART_OK:
                what = " ".join(str(x) for x in (d.get("devpath"), d.get("model")) if x)
                add("ERROR", "smart", f"{what} SMART health {health}")

    online = sorted((n for n in nodes.values() if n.online), key=lambda n: n.name)
    versions = {}
    for n in online:
        v = n.get("version", {}).get("version")
        if v:
            versions.setdefault(str(v), []).append(n.name)
    if len(versions) > 1:
        out.append(Finding("WARN", "", "version", "pve-manager differs: " + "; ".join(
            f"{v} ({', '.join(ns)})" for v, ns in sorted(versions.items(), key=lambda kv: kernel_key(kv[0])))))
    offsets = [(n.name, n.offset) for n in online if n.offset is not None]
    if len(offsets) > 1 and args.max_skew:
        lo = min(o for _, o in offsets)
        spread = max(o for _, o in offsets) - lo
        if spread > args.max_skew:
            out.append(Finding("WARN", "", "time", f"clock skew {spread:.0f}s between nodes (> {args.max_skew}s): "
                               + ", ".join(f"{name} +{o - lo:.0f}s" for name, o in offsets)))
    return out


def cmd_check(backend, args):
    now = time.time()
    endpoints = [ep for ep, checks in ENDPOINTS.items() if set(checks) - set(args.skip)]
    nodes, findings = collect(backend, args, endpoints)
    findings += run_checks(nodes, args, now)
    findings = [f for f in findings if f.check not in args.skip]
    if args.quiet:
        findings = [f for f in findings if f.severity != "INFO"]
    findings.sort(key=lambda f: (SEVERITY_RANK[f.severity], f.node, f.check))
    counts = severity_counts(findings)
    online = sum(1 for n in nodes.values() if n.online)
    if args.json:
        print(json.dumps({"summary": {"nodes": len(nodes), "online": online, **{k.lower(): v for k, v in counts.items()}},
                          "findings": [asdict(f) for f in findings]}, indent=2))
    else:
        if findings:
            print_findings(findings, [("SEV", lambda f: f.severity), ("NODE", lambda f: f.node or "cluster"),
                                      ("CHECK", lambda f: f.check), ("DETAIL", lambda f: f.detail)])
            print()
        print(f"{len(nodes)} node(s), {online} online: {counts['ERROR']} error, {counts['WARN']} warn, "
              f"{counts['INFO']} info")
    return exit_code(counts, args.fail_on)


def node_summary(n, now):
    st = n.get("status", {})
    run, new = running_kernel(st), newest_kernel(n.get("apt/versions"))
    certs = [_int(c.get("notafter")) for c in n.get("certificates/info", [])]
    certs = [c for c in certs if c is not None]
    return {
        "node": n.name, "online": n.online, "version": n.get("version", {}).get("version"),
        "kernel": run, "newest_kernel": new,
        "reboot": (kernel_key(new) > kernel_key(run)) if run and new else None,
        "uptime": _int(st.get("uptime")),
        "updates": len(n.data["apt/update"]) if isinstance(n.data.get("apt/update"), list) else None,
        "cert_expires": min(certs) if certs else None,
        "errors": dict(n.errors),
    }


def cmd_list(backend, args):
    now = time.time()
    nodes, _ = collect(backend, args, LIST_ENDPOINTS)
    rows = [node_summary(n, now) for n in sorted(nodes.values(), key=lambda n: n.name)]
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0

    def opt(v, f=str):
        return "?" if v is None else f(v)

    table = [[r["node"], "online" if r["online"] else "offline", opt(r["version"]), opt(r["kernel"]),
              {True: "yes", False: "no", None: "?"}[r["reboot"]], fmt_age(r["uptime"]) if r["uptime"] else "?",
              opt(r["updates"]), fmt_age(r["cert_expires"] - now) if r["cert_expires"] else "?"]
             for r in rows if r["online"]]
    table += [[r["node"], "offline"] + ["-"] * 6 for r in rows if not r["online"]]
    print_table(["NODE", "STATUS", "PVE", "KERNEL", "REBOOT", "UPTIME", "UPDATES", "CERT"], table)
    for r in rows:
        for ep, err in sorted(r["errors"].items()):
            print(C.yellow(f"warning: {r['node']} {ep}: {err}"), file=sys.stderr)
    print(f"\n{len(rows)} node(s), {sum(1 for r in rows if r['online'])} online")
    return 0


def build_parser():
    common = common_parser()
    common.add_argument("--node", action="append", help="only this node (repeatable)")
    p = argparse.ArgumentParser(prog="pvenode", description=__doc__.splitlines()[0])
    p.add_argument("--version", action="version", version=f"pvenode {VERSION}")
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")
    sub.required = True

    sp = sub.add_parser("list", parents=[common], help="version, kernel, reboot, uptime, updates, cert per node")
    sp.add_argument("--json", action="store_true", help="JSON output")

    sp = sub.add_parser("check", parents=[common], help="audit nodes, exit 1 on findings",
                        description="Checks: " + ", ".join(CHECKS) + ".")
    sp.add_argument("--max-usage", type=float, default=85.0,
                    help=f"warn above root fs / ZFS pool / thin pool usage %% (default 85, 0=off; "
                         f">= {FULL_PCT} is always ERROR)")
    sp.add_argument("--cert-warn", type=parse_age, default=parse_age("30d"),
                    help="warn if a certificate expires within (default 30d, 0=off)")
    sp.add_argument("--max-skew", type=int, default=5, help="warn above clock skew between nodes, seconds "
                                                             "(default 5, 0=off)")
    sp.add_argument("--skip", action="append", default=[], choices=CHECKS, metavar="CHECK",
                    help="skip a check (repeatable): " + ", ".join(CHECKS))
    sp.add_argument("--fail-on", choices=["warn", "error", "never"], default="warn",
                    help="exit 1 threshold (default warn)")
    sp.add_argument("-q", "--quiet", action="store_true", help="hide INFO findings")
    sp.add_argument("--json", action="store_true", help="JSON output")
    return p


def main(argv=None):
    return run_main(build_parser(), {"list": cmd_list, "check": cmd_check}, {"list", "check"}, "pvenode", argv)


if __name__ == "__main__":
    sys.exit(main())
