#!/usr/bin/env python3
"""Fake pvesh for tests: serves and mutates a JSON state file ($FAKE_PVE_STATE)."""
import fcntl
import json
import os
import re
import sys


def handle(st, method, path, params):
    if method == "get" and path == "/cluster/resources":
        return st["resources"]
    if method == "get" and path == "/cluster/tasks":
        return st.get("tasks", [])
    m = re.fullmatch(r"/nodes/([^/]+)/(qemu|lxc)/(\d+)/snapshot", path)
    if m and method == "get":
        if m.group(3) in st.get("broken_nodes", []):
            return 2, "hostname lookup failed"
        snaps = st["snapshots"].get(m.group(3), [])
        cur = st.get("current", {}).get(m.group(3))
        now = {"name": "current", "description": "You are here!"}
        if cur:
            now["parent"] = cur
        return snaps + [now]
    m = re.fullmatch(r"/nodes/([^/]+)/(qemu|lxc)/(\d+)/status/current", path)
    if m and method == "get":
        out = {"status": "running"}
        lock = st.get("locks", {}).get(m.group(3))
        if lock:
            out["lock"] = lock
        return out
    m = re.fullmatch(r"/nodes/([^/]+)/(qemu|lxc)/(\d+)/snapshot/([^/]+)", path)
    if m and method == "delete":
        node, vmid, name = m.group(1), m.group(3), m.group(4)
        st["seq"] = st.get("seq", 0) + 1
        upid = f"UPID:{node}:{st['seq']:08X}:00000000:00000000:qmdelsnapshot:{vmid}:root@pam:"
        tasks = st.setdefault("task_status", {})
        snaps = st["snapshots"].get(vmid, [])
        target = next((s for s in snaps if s["name"] == name), None)
        if target is None:
            return 2, f"snapshot '{name}' does not exist"
        fail = st.get("fail", {}).get(f"{vmid}/{name}")
        if fail and params.get("force") != "1":
            tasks[upid] = fail
            return upid
        parent = target.get("parent")
        for s in snaps:
            if s.get("parent") == name:
                if parent:
                    s["parent"] = parent
                else:
                    s.pop("parent", None)
        if st.get("current", {}).get(vmid) == name:
            st["current"][vmid] = parent
        snaps.remove(target)
        tasks[upid] = "OK"
        return upid
    m = re.fullmatch(r"/nodes/([^/]+)/tasks/([^/]+)/(status|log)", path)
    if m and method == "get":
        es = st.get("task_status", {}).get(m.group(2))
        if es is None:
            return 2, "no such task"
        if m.group(3) == "status":
            return {"status": "stopped", "exitstatus": es, "upid": m.group(2)}
        return [{"n": 1, "t": "fake task log"}, {"n": 2, "t": "TASK ERROR: " + es}]
    return 2, f"no handler for {method} {path}"


def main():
    method, path, rest = sys.argv[1], sys.argv[2], sys.argv[3:]
    params = {rest[i].lstrip("-"): rest[i + 1] for i in range(0, len(rest) - 1, 2)}
    with open(os.environ["FAKE_PVE_STATE"], "r+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        st = json.load(f)
        st.setdefault("calls", []).append([method, path, params])
        out = handle(st, method, path, params)
        f.seek(0)
        f.truncate()
        json.dump(st, f)
    if isinstance(out, tuple):
        print(out[1], file=sys.stderr)
        sys.exit(out[0])
    print(json.dumps(out))


if __name__ == "__main__":
    main()
