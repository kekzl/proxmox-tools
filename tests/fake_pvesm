#!/usr/bin/env python3
"""Fake 'pvesm free VOLID' for tests: removes the volume from $FAKE_PVE_STATE content lists."""
import fcntl
import json
import os
import sys


def main():
    if sys.argv[1:2] != ["free"] or len(sys.argv) != 3:
        print("usage: pvesm free VOLID", file=sys.stderr)
        sys.exit(2)
    volid = sys.argv[2]
    with open(os.environ["FAKE_PVE_STATE"], "r+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        st = json.load(f)
        st.setdefault("calls", []).append(["pvesm", "free", volid])
        found = False
        for lst in st.get("content", {}).values():
            before = len(lst)
            lst[:] = [e for e in lst if e["volid"] != volid]
            found = found or len(lst) != before
        f.seek(0)
        f.truncate()
        json.dump(st, f)
    if not found:
        print(f"volume {volid} does not exist", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
