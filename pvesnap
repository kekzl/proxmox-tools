def cmd_list(backend, args):
    guests, _ = load_guests(backend, args)
    now = time.time()
    if args.json:
        print(json.dumps([guest_json(g, now) for g in guests], indent=2))
        return 0
    shown = [g for g in guests if g.snaps or g.error or g.lock or args.empty]
    if args.flat:
        rows = []
        for g in shown:
            for s in sorted(g.snaps.values(), key=lambda s: (s.snaptime or 0, s.depth)):
                rows.append([g.vmid, g.name, g.node, s.name, s.parent or "-", fmt_time(s.snaptime),
                             fmt_age(now - s.snaptime) if s.snaptime else "?",
                             "yes" if s.vmstate else "", s.depth, short(s.description, 40)])
        print_table(["VMID", "NAME", "NODE", "SNAPSHOT", "PARENT", "CREATED", "AGE", "RAM", "DEPTH",
                     "DESCRIPTION"], rows)
    else:
        for g in shown:
            print_tree(g, now)
            print()
    hidden = len(guests) - len(shown)
    total = sum(len(g.snaps) for g in guests)
    note = f", {hidden} without snapshots hidden (-e shows them)" if hidden else ""
    print(f"{len(guests)} guest(s), {total} snapshot(s){note}")
    return 1 if any(g.error for g in guests) else 0


