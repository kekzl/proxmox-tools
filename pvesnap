@dataclass
class Snap:
    name: str
    parent: str | None = None
    snaptime: int | None = None
    description: str = ""
    vmstate: bool = False
    snapstate: str | None = None
    children: list = field(default_factory=list)
    depth: int = 0


@dataclass
class Guest:
    vmid: int
    node: str
    type: str
    name: str = ""
    status: str = ""
    lock: str | None = None
    template: bool = False
    snaps: dict = field(default_factory=dict)
    current_parent: str | None = None
    error: str | None = None
    broken: list = field(default_factory=list)
    cyclic: list = field(default_factory=list)

    @property
    def path(self):
        return f"/nodes/{self.node}/{self.type}/{self.vmid}"

    @property
    def tool(self):
        return "qm" if self.type == "qemu" else "pct"


def build_tree(g, entries):
    g.snaps, g.broken, g.cyclic, g.current_parent = {}, [], [], None
    for e in entries:
        name = e.get("name")
        if not name:
            continue
        if name == "current":
            g.current_parent = e.get("parent") or None
            continue
        g.snaps[name] = Snap(
            name=name,
            parent=e.get("parent") or None,
            snaptime=_int(e.get("snaptime")) or None,
            description=(e.get("description") or "").strip(),
            vmstate=bool(_int(e.get("vmstate"))),
            snapstate=e.get("snapstate") or None,
        )
    for s in g.snaps.values():
        if s.parent in g.snaps:
            g.snaps[s.parent].children.append(s.name)
        elif s.parent:
            g.broken.append((s.name, s.parent))
    for s in g.snaps.values():
        s.children.sort(key=lambda n: (g.snaps[n].snaptime or 0, n))
        depth, cur, seen = 0, s.name, set()
        while cur in g.snaps and cur not in seen:
            seen.add(cur)
            depth += 1
            cur = g.snaps[cur].parent
        if cur in seen:
            g.cyclic.append(s.name)
        s.depth = depth
    return g


def chain_depth(g):
    """Snapshots between the live state (NOW) and its root."""
    s = g.snaps.get(g.current_parent)
    return s.depth if s else 0


def ancestors(g, name):
    out, cur = [], name
    while cur in g.snaps and cur not in out:
        out.append(cur)
        cur = g.snaps[cur].parent
    return out


def descendants(g, name):
    out, stack = [], [name]
    while stack:
        cur = stack.pop()
        if cur in g.snaps and cur not in out:
            out.append(cur)
            stack.extend(g.snaps[cur].children)
    return out


def load_guests(backend, args):
    res = backend.get("/cluster/resources", type="vm") or []
    all_vmids, guests = set(), []
    for r in res:
        if r.get("type") not in ("qemu", "lxc"):
            continue
        vmid = _int(r.get("vmid"))
        if vmid is None:
            continue
        all_vmids.add(vmid)
        if not guest_filtered(args, vmid, r.get("node"), r["type"], r.get("name")):
            continue
        guests.append(Guest(vmid=vmid, node=r.get("node") or "", type=r["type"], name=r.get("name") or "",
                            status=r.get("status") or "", lock=r.get("lock") or None,
                            template=bool(_int(r.get("template")))))
    guests.sort(key=lambda g: g.vmid)

    def fetch(g):
        try:
            build_tree(g, backend.get(g.path + "/snapshot") or [])
        except PveError as e:
            g.error = str(e)

    with ThreadPoolExecutor(max_workers=args.jobs) as ex:
        list(ex.map(fetch, guests))
    return guests, all_vmids


def guest_json(g, now):
    return {
        "vmid": g.vmid, "name": g.name, "node": g.node, "type": g.type, "status": g.status,
        "lock": g.lock, "template": g.template, "error": g.error,
        "current_parent": g.current_parent, "chain_depth": chain_depth(g),
        "snapshots": [
            {"name": s.name, "parent": s.parent, "snaptime": s.snaptime,
             "age_seconds": int(now - s.snaptime) if s.snaptime else None,
             "vmstate": s.vmstate, "snapstate": s.snapstate, "depth": s.depth,
             "description": s.description}
            for s in sorted(g.snaps.values(), key=lambda s: (s.snaptime or 0, s.depth))
        ],
    }


# ---------------------------------------------------------------- rendering

def tree_rows(g):
    kids = {n: list(s.children) for n, s in g.snaps.items()}
    roots = sorted((n for n, s in g.snaps.items() if not s.parent or s.parent not in g.snaps),
                   key=lambda n: (g.snaps[n].snaptime or 0, n))
    if g.current_parent in g.snaps:
        kids[g.current_parent].append(NOW_NODE)
    else:
        roots.append(NOW_NODE)
    rows, seen = [], set()

    def walk(n, prefix, connector):
        rows.append((prefix + connector, n))
        if n == NOW_NODE or n in seen:
            return
        seen.add(n)
        if connector == "":
            child_prefix = prefix
        else:
            child_prefix = prefix + ("   " if connector == "└─ " else "│  ")
        ch = kids[n]
        for i, c in enumerate(ch):
            walk(c, child_prefix, "└─ " if i == len(ch) - 1 else "├─ ")

    for r in roots:
        walk(r, "", "")
    for n in g.snaps:
        if n not in seen:
            rows.append(("?? ", n))
            if n == g.current_parent:
                rows.append(("?? ", NOW_NODE))
    return rows


def guest_header(g):
    bits = [g.type, g.node, g.status or "?"] + (["template"] if g.template else [])
    head = f"{C.bold(str(g.vmid))} {g.name}  ({', '.join(bits)})"
    if g.lock:
        head += "  " + C.red(f"LOCK={g.lock}")
    if g.error:
        return head + "  " + C.red("ERROR: " + g.error)
    return head + f"  {len(g.snaps)} snapshot(s), chain depth {chain_depth(g)}"


def print_tree(g, now, marks=None):
    print(guest_header(g))
    if g.error:
        return
    rows = tree_rows(g)
    labels = [p + ("NOW" if n == NOW_NODE else n) for p, n in rows]
    width = max(len(l) for l in labels)
    for (prefix, n), label in zip(rows, labels):
        mark = "" if marks is None else (C.red("DEL ") if n in marks else "    ")
        if n == NOW_NODE:
            print(f"  {mark}{prefix}{C.green('NOW')}")
            continue
        s = g.snaps[n]
        age = fmt_age(now - s.snaptime) if s.snaptime else "?"
        extra = []
        if s.vmstate:
            extra.append("RAM")
        if s.snapstate:
            extra.append(C.red(f"snapstate={s.snapstate}"))
        if s.description:
            extra.append(C.dim(short(s.description)))
        print(f"  {mark}{label.ljust(width)}  {fmt_time(s.snaptime):16}  {age:>5}  {'  '.join(extra)}".rstrip())


