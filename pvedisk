@dataclass
class Finding:
    severity: str
    kind: str
    node: str
    storage: str
    volid: str
    vmid: int | None
    size: int | None
    detail: str
    shared: bool = False
    unused_key: str | None = None
    guest_node: str | None = None
    guest_type: str | None = None

    def ident(self):
        return (self.kind, "*" if self.shared else self.node, self.volid, self.vmid, self.unused_key)


def list_volumes(backend, node, storage):
    out = []
    for e in backend.get(f"/nodes/{node}/storage/{storage}/content") or []:
        if e.get("content") in ("images", "rootdir") and ":" in str(e.get("volid") or ""):
            out.append(e)
    return out


def scan(backend, args):
    """Returns (findings, info dict). Config refs come from all guests, filters apply to findings only."""
    res = backend.get("/cluster/resources") or []
    guests, storages = {}, {}
    for r in res:
        t = r.get("type")
        if t in ("qemu", "lxc"):
            vmid = _int(r.get("vmid"))
            if vmid is not None:
                guests[vmid] = GuestCfg(vmid, r.get("node") or "", t, r.get("name") or "", r.get("lock") or None)
        elif t == "storage" and r.get("storage") and r.get("node"):
            storages[(r["node"], r["storage"])] = r
    storage_ids = {s for _, s in storages}
    shared_ids = {s for (_, s), r in storages.items() if _int(r.get("shared"))}
    findings = []
    mode = load_configs(backend, list(guests.values()), storage_ids, args)

    busy = {g.vmid: f"locked '{g.lock}'" for g in guests.values() if g.lock}
    try:
        for t in backend.get("/cluster/tasks") or []:
            vmid = _int(t.get("id"))
            if vmid is not None and not t.get("endtime"):
                busy[vmid] = f"task {t.get('type')} running"
    except PveError as e:
        raise PveError(f"cannot read running tasks, refusing to classify volumes: {e}") from e
    replicas = set()
    try:
        for j in backend.get("/cluster/replication") or []:
            replicas.add((_int(j.get("guest")), j.get("target")))
    except PveError:
        pass

    targets, shared_node, shared_wanted = [], {}, set()
    for (node, st), r in sorted(storages.items()):
        if not set(str(r.get("content") or "").split(",")) & {"images", "rootdir"}:
            continue
        if args.storage and st not in args.storage:
            continue
        shared = st in shared_ids
        if not shared and args.node and node not in args.node:
            continue
        if shared:
            shared_wanted.add(st)
        if r.get("status") != "available":
            if not shared:
                findings.append(Finding("INFO", "scan", node, st, "", None, None,
                                        f"storage status '{r.get('status')}', not scanned"))
            continue
        if shared:
            if st in shared_node:
                continue
            shared_node[st] = node
        targets.append((node, st, shared))
    for st in sorted(shared_wanted - set(shared_node)):
        findings.append(Finding("INFO", "scan", "", st, "", None, None, "shared storage not available on any node",
                                shared=True))

    def fetch(t):
        node, st, shared = t
        try:
            return t, list_volumes(backend, node, st), None
        except PveError as e:
            return t, [], str(e)

    with ThreadPoolExecutor(max_workers=args.jobs) as ex:
        listed = list(ex.map(fetch, targets))

    refidx = {}
    for g in guests.values():
        if g.error:
            continue
        for (st, vol), wheres in g.refs.items():
            local = st not in shared_ids
            refidx.setdefault(("*" if not local else g.node, st, vol), []).append((g.vmid, set(wheres)))
            if local:
                for gv, target in replicas:
                    if gv == g.vmid and target and target != g.node:
                        refidx.setdefault((target, st, vol), []).append((g.vmid, {"replica"}))

    unreadable = set()
    for g in guests.values():
        if g.error:
            unreadable.add(g.vmid)
            findings.append(Finding("WARN", "config", g.node, "", "", g.vmid, None,
                                    f"config unreadable, volumes of {g.vmid} not classified: {g.error}"))

    present, listed_scopes = set(), set()
    for (node, st, shared), vols, err in listed:
        if err:
            findings.append(Finding("WARN", "scan", node, st, "", None, None, f"cannot list: {err}", shared=shared))
            continue
        scope = "*" if shared else node
        listed_scopes.add((scope, st))
        for e in vols:
            volid = e["volid"]
            norm = norm_vol(volid.split(":", 1)[1])
            present.add((scope, st, norm))
            vmid, size = _int(e.get("vmid")), _int(e.get("size"))

            def add(sev, kind, detail, **kw):
                findings.append(Finding(sev, kind, node, st, volid, kw.pop("owner", vmid), size, detail,
                                        shared, **kw))

            hits = refidx.get((scope, st, norm))
            if hits:
                wheres = set().union(*(w for _, w in hits))
                if wheres == {"unused"} and len(hits) == 1:
                    owner = guests[hits[0][0]]
                    key = owner.unused.get((st, norm))
                    add("INFO", "unused", f"detached disk {key} of {owner.vmid}", owner=owner.vmid, unused_key=key,
                        guest_node=owner.node, guest_type=owner.type)
                elif wheres == {"snapshot"} and not STATE_VOL_RE.search(norm):
                    add("INFO", "snapshot-only",
                        "only referenced by snapshots of " + ", ".join(sorted({str(v) for v, _ in hits})))
                continue
            if vmid is None or vmid in unreadable:
                continue
            if vmid in busy:
                add("INFO", "busy", f"not referenced, guest {vmid} busy ({busy[vmid]}), skipped")
                continue
            g = guests.get(vmid)
            if g is None:
                add("WARN", "orphan", f"guest {vmid} does not exist")
            elif shared or g.node == node:
                add("WARN", "orphan", f"not in any config section of {vmid} {g.name}".rstrip())
            else:
                add("WARN", "stale", f"guest {vmid} lives on {g.node}, no replication to {node}: leftover copy, "
                                     f"verify the storage is not really shared")

    for g in guests.values():
        if g.error:
            continue
        for (st, vol), wheres in sorted(g.refs.items()):
            scope = "*" if st in shared_ids else g.node
            if not wheres & {"config", "unused"} or (scope, st) not in listed_scopes:
                continue
            if not DISKNAME_RE.search(vol) or (scope, st, vol) in present:
                continue
            keys = ", ".join(sorted(g.keys.get((st, vol), [])))
            sev = "ERROR" if "config" in wheres else "INFO"
            findings.append(Finding(sev, "missing", g.node, st, f"{st}:{vol}", g.vmid, None,
                                    f"{keys} of {g.vmid} references a volume that is not on the storage",
                                    shared=st in shared_ids))

    findings = [f for f in findings if finding_selected(f, args)]
    findings.sort(key=lambda f: (SEVERITY_RANK[f.severity], KIND_ORDER.get(f.kind, 9), f.storage, f.volid))
    info = {"config_source": mode, "guests": len(guests), "storages": len(listed),
            "volumes": sum(len(v) for _, v, _ in listed)}
    return findings, info


def finding_selected(f, args):
    if args.guests is not None and f.vmid not in args.guests:
        return False
    if args.node and not f.shared and f.node and f.node not in args.node:
        return False
    return not (getattr(args, "match", None) and f.volid and not args.match.search(f.volid))


def summary_line(findings, info):
    parts = []
    for kind in ("orphan", "stale", "unused", "missing", "snapshot-only", "busy"):
        sel = [f for f in findings if f.kind == kind]
        if sel:
            size = sum(f.size or 0 for f in sel)
            parts.append(f"{kind} {len(sel)}" + (f" ({fmt_size(size)})" if size else ""))
    return (f"{info['volumes']} volume(s) on {info['storages']} storage scope(s), {info['guests']} guest config(s) "
            f"via {info['config_source']}: " + (", ".join(parts) or "nothing found"))


FINDING_COLUMNS = [("SEV", lambda f: f.severity), ("KIND", lambda f: f.kind),
                   ("VMID", lambda f: f.vmid if f.vmid is not None else "-"),
                   ("NODE", lambda f: "shared" if f.shared else (f.node or "-")),
                   ("STORAGE", lambda f: f.storage or "-"), ("VOLUME", lambda f: f.volid or "-"),
                   ("SIZE", lambda f: fmt_size(f.size) if f.size is not None else "-"),
                   ("DETAIL", lambda f: f.detail)]


def cmd_check(backend, args):
    findings, info = scan(backend, args)
    if args.quiet:
        findings = [f for f in findings if f.severity != "INFO"]
    counts = severity_counts(findings)
    if args.json:
        print(json.dumps({"summary": {**info, **{k.lower(): v for k, v in counts.items()}},
                          "findings": [asdict(f) for f in findings]}, indent=2))
    else:
        if findings:
            print_findings(findings, FINDING_COLUMNS)
            print()
        print(summary_line(findings, info))
    return exit_code(counts, args.fail_on)


# ---------------------------------------------------------------- delete

_LOCAL_NODE = []


def local_node(backend):
    if not _LOCAL_NODE:
        name = None
        try:
            for e in backend.get("/cluster/status") or []:
                if e.get("type") == "node" and _int(e.get("local")):
                    name = e.get("name")
        except PveError:
            pass
        _LOCAL_NODE.append(name or socket.gethostname().split(".")[0])
    return _LOCAL_NODE[0]


def free_volume(backend, f, args):
    volname = f.volid.split(":", 1)[1]
    if not backend.local or "/" not in volname:
        upid = backend.delete(f"/nodes/{f.node}/storage/{f.storage}/content/{backend.seg(f.volid)}")
        return wait_task(backend, upid, args.timeout) if upid else ""
    # pvesh cannot address volids with '/', pvesm free works for shared or local-node storage
    if not f.shared and f.node != local_node(backend):
        raise PveError(f"path-style volume on remote node: run 'pvesm free {f.volid}' on {f.node}")
    p = subprocess.run([args.pvesm, "free", f.volid], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                       universal_newlines=True, start_new_session=True)
    if p.returncode != 0:
        raise PveError(f"pvesm free {f.volid}: {(p.stderr or p.stdout).strip()}")
    return ""


def drop_unused(backend, f, args):
    path = f"/nodes/{f.guest_node}/{f.guest_type}/{f.vmid}/config"
    cfg = backend.get(path) or {}
    val = str(cfg.get(f.unused_key) or "")
    st, vol = f.volid.split(":", 1)
    if (st, norm_vol(vol)) not in {(s, norm_vol(v)) for s, v in value_volids(val, {st})}:
        raise PveError(f"{f.unused_key} of {f.vmid} changed to '{val or 'nothing'}'")
    params = {"delete": f.unused_key}
    if cfg.get("digest"):
        params["digest"] = cfg["digest"]
    upid = backend.set(path, **params)
    return wait_task(backend, upid, args.timeout) if upid else ""


def cmd_delete(backend, args):
    kinds = set(args.kind or ["orphan"])
    findings, info = scan(backend, args)
    plan = [f for f in findings if f.kind in kinds]
    if not plan:
        print(summary_line(findings, info))
        print("nothing to delete")
        return 0
    print_findings(plan, FINDING_COLUMNS)
    total = sum(f.size or 0 for f in plan)
    print(f"\nplan: delete {len(plan)} volume(s), {fmt_size(total)}, kinds {','.join(sorted(kinds))}")
    if "stale" in kinds:
        print(C.yellow("stale: volumes on a node-local storage of a guest living elsewhere; wrong if that storage "
                       "is shared but not flagged 'shared' in storage.cfg"))
    if args.dry_run:
        print("dry run: nothing deleted")
        return 0
    if not confirm(args):
        print("aborted")
        return 1

    fresh, _ = scan(backend, args)
    still = {f.ident() for f in fresh}
    ok = failed = skipped = 0
    done = []
    with Stopper() as stopper:
        for i, f in enumerate(plan, 1):
            tag = f"({i}/{len(plan)}) {f.kind} {f.volid}"
            if stopper.stop:
                skipped += len(plan) - i + 1
                print(f"stopped, {len(plan) - i + 1} volume(s) left")
                break
            if f.ident() not in still:
                skipped += 1
                print(C.yellow(f"{tag}: changed since plan, skipped"))
                continue
            t0 = time.monotonic()
            print(f"{tag} ...", flush=True)
            try:
                warn = drop_unused(backend, f, args) if f.kind == "unused" else free_volume(backend, f, args)
            except PveError as e:
                failed += 1
                print(C.red(f"{tag}: FAILED: {e}"), flush=True)
                continue
            ok += 1
            done.append(f)
            print(C.green(f"{tag}: deleted") + f" ({time.monotonic() - t0:.0f}s){warn}", flush=True)

    for (node, st) in sorted({(f.node, f.storage) for f in done}):
        try:
            left = {e["volid"] for e in list_volumes(backend, node, st)}
        except PveError as e:
            print(C.yellow(f"verify {st} on {node} failed: {e}"))
            continue
        for f in done:
            if (f.node, f.storage) == (node, st) and f.volid in left:
                ok -= 1
                failed += 1
                hint = " (config entry removed, volume left: rerun with --kind orphan)" if f.kind == "unused" else ""
                print(C.red(f"{f.volid}: still present after delete{hint}"))
    print(f"\ndeleted {ok}, failed {failed}, skipped {skipped}, freed ~{fmt_size(sum(f.size or 0 for f in done))}")
    return 0 if not failed and not skipped else 1


# ---------------------------------------------------------------- cli

def build_parser():
    common = common_parser()
    filt = argparse.ArgumentParser(add_help=False)
    fg = filt.add_argument_group("filters (apply to findings, all guest configs are always read)")
    fg.add_argument("guests", nargs="?", default="all", type=parse_idspec, metavar="GUESTS",
                    help="volume owner vmids: 100 | 100,101 | 200-210 | all")
    fg.add_argument("--node", action="append", help="only node-local storages of this node (repeatable)")
    fg.add_argument("--storage", action="append", help="only this storage (repeatable)")
    fg.add_argument("--config-source", choices=["auto", "files", "api"], default="auto",
                    help="guest configs from /etc/pve files (fast, local backend) or API (default auto)")
    fg.add_argument("--pve-dir", default="/etc/pve", help=argparse.SUPPRESS)
    fg.add_argument("--pvesm", default="pvesm", help=argparse.SUPPRESS)

    p = argparse.ArgumentParser(prog="pvedisk", description=__doc__.splitlines()[0])
    p.add_argument("--version", action="version", version=f"pvedisk {VERSION}")
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")
    sub.required = True

    sp = sub.add_parser("check", parents=[common, filt], help="report orphaned, stale, unused and missing volumes",
                        description="Kinds: orphan (no config references it), stale (copy on another node's "
                                    "local storage), unused (detached unusedN disk), missing (config references "
                                    "absent volume), snapshot-only, busy (guest locked or task running).")
    sp.add_argument("--fail-on", choices=["warn", "error", "never"], default="warn",
                    help="exit 1 threshold (default warn)")
    sp.add_argument("-q", "--quiet", action="store_true", help="hide INFO findings")
    sp.add_argument("--json", action="store_true", help="JSON output")

    sp = sub.add_parser("delete", parents=[common, filt], help="delete volumes found by check",
                        formatter_class=argparse.RawDescriptionHelpFormatter,
                        description="Re-scans after confirmation and deletes only findings that are unchanged.\n"
                                    "orphan/stale: storage content delete. unused: config 'delete unusedN'.",
                        epilog="examples:\n"
                               "  pvedisk delete -n                       # plan for all orphans\n"
                               "  pvedisk delete --storage local-zfs -y\n"
                               "  pvedisk delete 100-199 --kind orphan --kind unused\n"
                               "  pvedisk delete --kind stale --node pve2 -n")
    sp.add_argument("--kind", action="append", choices=DELETABLE,
                    help="kinds to delete (repeatable, default orphan)")
    sp.add_argument("--match", type=regex, metavar="RE", help="only volids matching regex")
    sp.add_argument("-n", "--dry-run", action="store_true", help="show the plan only")
    sp.add_argument("-y", "--yes", action="store_true", help="no confirmation prompt")
    sp.add_argument("--timeout", type=positive_int, default=1800, help="seconds per task (default 1800)")
    return p


def main(argv=None):
    return run_main(build_parser(), {"check": cmd_check, "delete": cmd_delete}, {"check"}, "pvedisk", argv)


if __name__ == "__main__":
    sys.exit(main())
