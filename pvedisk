DISKNAME_RE = re.compile(r"(?:^|/)(?:vm|base|subvol|basevol)-\d+-(?:disk-\d+|cloudinit|state-[^/]+)(?:\.\w+)?$")
STATE_VOL_RE = re.compile(r"(?:^|/)vm-\d+-state-[^/]+$")
LINKED_RE = re.compile(r"^((?:\d+/)?base-\d+-disk-\d+(?:\.\w+)?)/(.+)$")
STORAGE_ID_RE = re.compile(r"^[A-Za-z][A-Za-z0-9\-_.]*$")
SKIP_KEYS = {"description", "digest", "parent", "snaptime", "snapstate", "delete", "tags", "lock", "name",
             "hostname", "meta", "smbios1", "vmgenid", "net0", "boot"}
DELETABLE = ("orphan", "stale", "unused")
KIND_ORDER = {"missing": 0, "orphan": 1, "stale": 2, "scan": 3, "config": 4, "unused": 5, "snapshot-only": 6,
              "busy": 7}


# ---------------------------------------------------------------- config parsing

def norm_vol(volname):
    """Linked clone 'base-200-disk-0/vm-100-disk-0' -> 'vm-100-disk-0'."""
    m = LINKED_RE.match(volname)
    return m.group(2) if m else volname


def vol_keys(storage, volname):
    m = LINKED_RE.match(volname)
    if m:
        return [(storage, m.group(2)), (storage, m.group(1))]
    return [(storage, volname)]


def value_volids(value, storage_ids):
    """'local-lvm:vm-100-disk-0,size=32G' -> [('local-lvm', 'vm-100-disk-0')]."""
    out = []
    for part in str(value).split(","):
        k, eq, v = part.partition("=")
        cand = v if eq and k.strip() in ("file", "volume") else (None if eq else part)
        if not cand or ":" not in cand:
            continue
        st, _, vol = cand.strip().partition(":")
        if vol and STORAGE_ID_RE.match(st) and st in storage_ids:
            out.append((st, vol))
    return out


def parse_conf(text):
    """PVE guest .conf -> {section: {key: value}}; '' = current, 'PENDING', snapshot names."""
    sections, cur = {"": {}}, ""
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.fullmatch(r"\[([^\]]+)\]", line)
        if m:
            cur = m.group(1)
            sections.setdefault(cur, {})
            continue
        k, sep, v = line.partition(":")
        if sep:
            sections[cur][k.strip()] = v.strip()
    return sections


@dataclass
class GuestCfg:
    vmid: int
    node: str
    type: str
    name: str = ""
    lock: str | None = None
    refs: dict = field(default_factory=dict)      # (storage, vol) -> {config, pending, snapshot, unused}
    keys: dict = field(default_factory=dict)      # (storage, vol) -> current config keys
    unused: dict = field(default_factory=dict)    # (storage, vol) -> unusedN
    error: str | None = None

    @property
    def path(self):
        return f"/nodes/{self.node}/{self.type}/{self.vmid}"


def apply_refs(g, sections, storage_ids):
    for sec, kv in sections.items():
        base_where = "config" if sec == "" else "pending" if sec == "PENDING" else "snapshot"
        for k, v in kv.items():
            if k in SKIP_KEYS:
                continue
            for st, vol in value_volids(v, storage_ids):
                where = "unused" if sec == "" and k.startswith("unused") else base_where
                for key in vol_keys(st, vol):
                    g.refs.setdefault(key, set()).add(where)
                    if sec == "":
                        g.keys.setdefault(key, set()).add(k)
                    if where == "unused":
                        g.unused[key] = k


def read_conf_file(root, g):
    sub = "qemu-server" if g.type == "qemu" else "lxc"
    with open(os.path.join(root, "nodes", g.node, sub, f"{g.vmid}.conf"), encoding="utf-8", errors="replace") as f:
        return parse_conf(f.read())


def read_conf_api(backend, g):
    cfg = backend.get(g.path + "/config") or {}
    sections = {"": {k: str(v) for k, v in cfg.items()}}
    try:
        pend = backend.get(g.path + "/pending") or []
        sections["PENDING"] = {}
        for e in pend:
            for field_name in ("value", "pending"):
                if field_name in e:
                    sections["PENDING"][f"{e.get('key')}#{field_name}"] = str(e[field_name])
    except PveError:
        pass
    for s in backend.get(g.path + "/snapshot") or []:
        name = s.get("name")
        if name and name != "current":
            snap_cfg = backend.get(f"{g.path}/snapshot/{name}/config") or {}
            sections[name] = {k: str(v) for k, v in snap_cfg.items()}
    return sections


def load_configs(backend, guests, storage_ids, args):
    mode = args.config_source
    files_ok = os.path.isdir(os.path.join(args.pve_dir, "nodes"))
    if mode == "auto":
        mode = "files" if backend.local and files_ok else "api"
    if mode == "files" and not files_ok:
        raise PveError(f"--config-source files: {args.pve_dir}/nodes not found")

    def fetch(g):
        try:
            sections = read_conf_file(args.pve_dir, g) if mode == "files" else read_conf_api(backend, g)
            apply_refs(g, sections, storage_ids)
        except (PveError, OSError, ValueError) as e:
            g.error = str(e)

    with ThreadPoolExecutor(max_workers=args.jobs) as ex:
        list(ex.map(fetch, guests))
    return mode


